{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/deployment-role-acceptance-v1.json",
  "title": "P42 deployment-bound governance role possession and acceptance packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policyVersion", "chainId", "releaseBindingDigest", "capsuleDigest", "slateDigest", "configDigest", "deploymentCommit", "timelock", "topologyDigest", "contractCount", "expiresAt", "acceptances", "packetDigest"],
  "properties": {
    "schema": { "const": "p42-prizes/deployment-role-acceptance/v1" },
    "policyVersion": { "const": "p42-governance-role-policy/v1" },
    "chainId": { "type": "integer", "minimum": 1 },
    "releaseBindingDigest": { "$ref": "#/$defs/digest" },
    "capsuleDigest": { "$ref": "#/$defs/digest" },
    "slateDigest": { "$ref": "#/$defs/digest" },
    "configDigest": { "$ref": "#/$defs/digest" },
    "deploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timelock": { "$ref": "#/$defs/address" },
    "topologyDigest": { "$ref": "#/$defs/digest" },
    "contractCount": { "const": 46 },
    "expiresAt": { "type": "integer", "minimum": 1 },
    "acceptances": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/acceptance" } },
    "packetDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "address", "nonce", "riskAccepted", "roleAccepted", "signature"],
      "properties": {
        "role": { "enum": ["timelock-signer", "guardian", "treasury", "resolver"] },
        "address": { "$ref": "#/$defs/address" },
        "nonce": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "riskAccepted": { "const": true },
        "roleAccepted": { "const": true },
        "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" }
      }
    }
  }
}
