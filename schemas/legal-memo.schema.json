{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/legal-memo-v1.json",
  "title": "P42 Legal Memo v1",
  "type": "object",
  "required": [
    "schema_version",
    "memo_id",
    "completed_at_utc",
    "jurisdiction",
    "entity",
    "memo_reference",
    "legal_owner",
    "agent_prepared_by",
    "counsel",
    "scope",
    "launch_constraints",
    "counsel_findings",
    "documents_reviewed",
    "residual_risks",
    "agent_attestation",
    "legal_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p42-legal-memo/v1" },
    "memo_id": { "type": "string", "minLength": 1 },
    "completed_at_utc": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "entity": { "type": "string", "minLength": 1 },
    "memo_reference": { "type": "string", "minLength": 1 },
    "legal_owner": { "type": "string", "minLength": 1 },
    "agent_prepared_by": { "type": "string", "minLength": 1 },
    "counsel": {
      "type": "object",
      "required": ["name", "firm", "bar_jurisdiction", "engagement_reference", "signed_at_utc"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "firm": { "type": "string", "minLength": 1 },
        "bar_jurisdiction": { "type": "string", "minLength": 1 },
        "engagement_reference": { "type": "string", "minLength": 1 },
        "signed_at_utc": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "prize_bounty_structure_reviewed",
        "money_transmission_reviewed",
        "kyc_sanctions_reviewed",
        "tax_reporting_reviewed",
        "terms_privacy_reviewed",
        "coinbase_onramp_reviewed",
        "custody_wallet_controls_reviewed",
        "no_token_or_points_reviewed",
        "international_access_reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "prize_bounty_structure_reviewed": { "const": true },
        "money_transmission_reviewed": { "const": true },
        "kyc_sanctions_reviewed": { "const": true },
        "tax_reporting_reviewed": { "const": true },
        "terms_privacy_reviewed": { "const": true },
        "coinbase_onramp_reviewed": { "const": true },
        "custody_wallet_controls_reviewed": { "const": true },
        "no_token_or_points_reviewed": { "const": true },
        "international_access_reviewed": { "const": true }
      }
    },
    "launch_constraints": {
      "type": "object",
      "required": [
        "no_mainnet_until_contract_audit",
        "no_mainnet_until_governance_signoff",
        "no_onramp_until_reviewed_mainnet_pool",
        "payouts_require_sanctions_screening_policy",
        "memo_attached_or_referenced",
        "terms_path",
        "privacy_path",
        "risk_disclosures_path",
        "kyc_sanctions_policy_path",
        "tax_reporting_policy_path"
      ],
      "additionalProperties": false,
      "properties": {
        "no_mainnet_until_contract_audit": { "const": true },
        "no_mainnet_until_governance_signoff": { "const": true },
        "no_onramp_until_reviewed_mainnet_pool": { "const": true },
        "payouts_require_sanctions_screening_policy": { "const": true },
        "memo_attached_or_referenced": { "const": true },
        "terms_path": { "type": "string", "minLength": 1 },
        "privacy_path": { "type": "string", "minLength": 1 },
        "risk_disclosures_path": { "type": "string", "minLength": 1 },
        "kyc_sanctions_policy_path": { "type": "string", "minLength": 1 },
        "tax_reporting_policy_path": { "type": "string", "minLength": 1 }
      }
    },
    "counsel_findings": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["topic", "status", "conclusion", "evidence_reference", "required_before_mainnet"],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "enum": [
              "prize_bounty_classification",
              "money_transmission",
              "kyc_sanctions",
              "tax_reporting",
              "terms_privacy",
              "coinbase_onramp",
              "custody_non_custodial_controls",
              "no_token_or_points",
              "international_access"
            ]
          },
          "status": { "enum": ["approved", "requires_change", "blocked"] },
          "conclusion": { "type": "string", "minLength": 1 },
          "evidence_reference": { "type": "string", "minLength": 1 },
          "required_before_mainnet": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "documents_reviewed": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["path", "status", "version_or_hash"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status": { "const": "reviewed" },
          "version_or_hash": { "type": "string", "minLength": 1 }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "severity", "disposition", "owner"],
        "additionalProperties": false,
        "properties": {
          "risk": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "disposition": { "enum": ["accepted", "mitigated", "transferred", "open"] },
          "owner": { "type": "string", "minLength": 1 },
          "due_utc": { "type": "string", "minLength": 1 }
        }
      }
    },
    "agent_attestation": {
      "type": "object",
      "required": ["legal_owner", "agent_prepared_by", "signed_at_utc", "statement"],
      "additionalProperties": false,
      "properties": {
        "legal_owner": { "type": "string", "minLength": 1 },
        "agent_prepared_by": { "type": "string", "minLength": 1 },
        "signed_at_utc": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "legal_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
