{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/legal-memo.json",
  "title": "P42 Legal Memo",
  "type": "object",
  "required": [
    "schema_version",
    "memo_id",
    "completed_at_utc",
    "jurisdiction",
    "entity",
    "memo_artifact",
    "release_binding",
    "legal_owner",
    "agent_prepared_by",
    "counsel",
    "scope",
    "launch_constraints",
    "counsel_findings",
    "documents_reviewed",
    "residual_risks",
    "agent_attestation",
    "counsel_signature",
    "legal_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["p42-legal-memo/v1", "p42-legal-memo/v2"] },
    "memo_id": { "type": "string", "minLength": 1 },
    "completed_at_utc": { "type": "string", "format": "date-time" },
    "jurisdiction": { "type": "string", "minLength": 2, "pattern": "^(?![Tt][Bb][Dd]$|[Tt][Ee][Ss][Tt]$|[Dd][Uu][Mm][Mm][Yy]$).+" },
    "entity": { "type": "string", "minLength": 1 },
    "memo_artifact": { "$ref": "#/$defs/artifact" },
    "release_binding": {
      "oneOf": [
        { "$ref": "#/$defs/legacyReleaseBinding" },
        { "$ref": "#/$defs/canonicalReleaseBinding" }
      ]
    },
    "legal_owner": { "type": "string", "minLength": 1 },
    "agent_prepared_by": { "type": "string", "minLength": 1 },
    "counsel": {
      "type": "object",
      "required": [
        "name",
        "organization",
        "professional_email",
        "role",
        "public_key",
        "identity_evidence",
        "independent_from_p42",
        "bar_jurisdiction",
        "license_identifier",
        "engagement_artifact",
        "signed_at_utc",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 2 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "external-counsel" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" },
        "independent_from_p42": { "const": true },
        "bar_jurisdiction": { "type": "string", "minLength": 2 },
        "license_identifier": { "type": "string", "minLength": 4 },
        "engagement_artifact": { "$ref": "#/$defs/artifact" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "prize_bounty_structure_reviewed",
        "money_transmission_reviewed",
        "kyc_sanctions_reviewed",
        "tax_reporting_reviewed",
        "terms_privacy_reviewed",
        "coinbase_onramp_reviewed",
        "custody_wallet_controls_reviewed",
        "no_token_or_points_reviewed",
        "international_access_reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "prize_bounty_structure_reviewed": { "const": true },
        "money_transmission_reviewed": { "const": true },
        "kyc_sanctions_reviewed": { "const": true },
        "tax_reporting_reviewed": { "const": true },
        "terms_privacy_reviewed": { "const": true },
        "coinbase_onramp_reviewed": { "const": true },
        "custody_wallet_controls_reviewed": { "const": true },
        "no_token_or_points_reviewed": { "const": true },
        "international_access_reviewed": { "const": true }
      }
    },
    "launch_constraints": {
      "type": "object",
      "required": [
        "no_mainnet_until_contract_audit",
        "no_mainnet_until_governance_signoff",
        "no_onramp_until_reviewed_mainnet_pool",
        "payouts_require_sanctions_screening_policy",
        "memo_attached_or_referenced",
        "terms_path",
        "privacy_path",
        "risk_disclosures_path",
        "kyc_sanctions_policy_path",
        "tax_reporting_policy_path"
      ],
      "additionalProperties": false,
      "properties": {
        "no_mainnet_until_contract_audit": { "const": true },
        "no_mainnet_until_governance_signoff": { "const": true },
        "no_onramp_until_reviewed_mainnet_pool": { "const": true },
        "payouts_require_sanctions_screening_policy": { "const": true },
        "memo_attached_or_referenced": { "const": true },
        "terms_path": { "type": "string", "minLength": 1 },
        "privacy_path": { "type": "string", "minLength": 1 },
        "risk_disclosures_path": { "type": "string", "minLength": 1 },
        "kyc_sanctions_policy_path": { "type": "string", "minLength": 1 },
        "tax_reporting_policy_path": { "type": "string", "minLength": 1 }
      }
    },
    "counsel_findings": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["topic", "status", "conclusion", "evidence_artifact", "required_before_mainnet"],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "enum": [
              "prize_bounty_classification",
              "money_transmission",
              "kyc_sanctions",
              "tax_reporting",
              "terms_privacy",
              "coinbase_onramp",
              "custody_non_custodial_controls",
              "no_token_or_points",
              "international_access"
            ]
          },
          "status": { "const": "approved" },
          "conclusion": { "type": "string", "minLength": 1 },
          "evidence_artifact": { "$ref": "#/$defs/artifact" },
          "required_before_mainnet": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "documents_reviewed": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["artifact", "status"],
        "additionalProperties": false,
        "properties": {
          "artifact": { "$ref": "#/$defs/artifact" },
          "status": { "const": "reviewed" }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "severity", "disposition", "owner"],
        "additionalProperties": false,
        "properties": {
          "risk": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "disposition": { "enum": ["accepted", "mitigated", "transferred", "open"] },
          "owner": { "type": "string", "minLength": 1 },
          "due_utc": { "type": "string", "format": "date-time" }
        }
      }
    },
    "agent_attestation": {
      "type": "object",
      "required": ["legal_owner", "agent_prepared_by", "signed_at_utc", "statement"],
      "additionalProperties": false,
      "properties": {
        "legal_owner": { "type": "string", "minLength": 1 },
        "agent_prepared_by": { "type": "string", "minLength": 1 },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "counsel_signature": { "$ref": "#/$defs/signature" },
    "legal_hash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "p42-legal-memo/v1" } } },
      "then": { "properties": { "release_binding": { "$ref": "#/$defs/legacyReleaseBinding" } } },
      "else": { "properties": { "release_binding": { "$ref": "#/$defs/canonicalReleaseBinding" } } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "publicKey": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["uri", "local_path", "sha256", "created_at_utc"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "sha256": { "$ref": "#/$defs/hash" },
        "created_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "legacyContract": {
      "type": "object",
      "required": ["name", "address", "runtime_bytecode_hash", "source_artifact", "runtime_bytecode_artifact", "chain_bytecode_artifact"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "P42BountyPool",
            "P42PayoutLedger",
            "P42SubmissionManager",
            "P42ChallengeManager",
            "P42ProblemRegistry"
          ]
        },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "runtime_bytecode_hash": { "$ref": "#/$defs/hash" },
        "source_artifact": { "$ref": "#/$defs/artifact" },
        "runtime_bytecode_artifact": { "$ref": "#/$defs/artifact" },
        "chain_bytecode_artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "canonicalContract": {
      "type": "object",
      "required": ["topology_key", "name", "address", "runtime_bytecode_hash", "manifest_runtime_code_hash", "source_artifact", "runtime_bytecode_artifact", "chain_bytecode_artifact"],
      "additionalProperties": false,
      "properties": {
        "topology_key": {
          "type": "string",
          "pattern": "^(?:shared\\.(?:timelock|registry|rolloverVault|submissionManagerFactory|challengeManagerFactory|objectiveVerifier|resolverQuorum)|board\\.(?:[1-9]|10)\\.(?:pool|ledger|submissions|challenges))$"
        },
        "name": {
          "enum": [
            "P42MultisigTimelock",
            "P42ProblemRegistry",
            "P42RolloverVault",
            "P42SubmissionManagerFactory",
            "P42ChallengeManagerFactory",
            "P42SP1VerifierGateway",
            "P42ResolverQuorum",
            "P42BountyPool",
            "P42PayoutLedger",
            "P42SubmissionManager",
            "P42ChallengeManager"
          ]
        },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "runtime_bytecode_hash": { "$ref": "#/$defs/hash" },
        "manifest_runtime_code_hash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
        "source_artifact": { "$ref": "#/$defs/artifact" },
        "runtime_bytecode_artifact": { "$ref": "#/$defs/artifact" },
        "chain_bytecode_artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "legacyReleaseBinding": {
      "type": "object",
      "required": [
        "repository_uri",
        "git_commit",
        "network",
        "chain_id",
        "deployment_manifest",
        "configuration_artifact",
        "contracts"
      ],
      "additionalProperties": false,
      "properties": {
        "repository_uri": { "type": "string", "pattern": "^https://" },
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "network": { "enum": ["local", "base-sepolia", "base-mainnet"] },
        "chain_id": { "type": "integer", "enum": [31337, 8453, 84532] },
        "deployment_manifest": { "$ref": "#/$defs/artifact" },
        "configuration_artifact": { "$ref": "#/$defs/artifact" },
        "contracts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/legacyContract" }
        }
      }
    },
    "canonicalReleaseBinding": {
      "type": "object",
      "required": [
        "binding_version",
        "repository_uri",
        "deployment_commit",
        "git_commit",
        "network",
        "chain_id",
        "canonical_topology",
        "release_capsule",
        "capsule_rebuild_attestation",
        "deployment_manifest",
        "configuration_artifact",
        "contracts"
      ],
      "additionalProperties": false,
      "properties": {
        "binding_version": { "const": "p42-release-binding/v2" },
        "repository_uri": { "type": "string", "pattern": "^https://" },
        "deployment_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "network": { "const": "base-sepolia" },
        "chain_id": { "const": 84532 },
        "canonical_topology": { "$ref": "#/$defs/artifact" },
        "release_capsule": { "$ref": "#/$defs/artifact" },
        "capsule_rebuild_attestation": { "$ref": "#/$defs/artifact" },
        "deployment_manifest": { "$ref": "#/$defs/artifact" },
        "configuration_artifact": { "$ref": "#/$defs/artifact" },
        "contracts": {
          "type": "array",
          "minItems": 47,
          "maxItems": 47,
          "items": { "$ref": "#/$defs/canonicalContract" }
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "const": "external-counsel" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/hash" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    }
  }
}
