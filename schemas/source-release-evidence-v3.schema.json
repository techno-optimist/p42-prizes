{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/source-release-evidence-v3.schema.json",
  "title": "P42 fail-closed source release evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "createdAt", "repository", "branch", "deployRelevantCommit", "observedBranchHead", "previousEvidence", "trustPolicy", "ci", "deployProvenance", "render", "releaseGuard", "portalProjection", "evidenceHash"],
  "properties": {
    "schemaVersion": {"const": "p42-source-release-evidence/v3"},
    "createdAt": {"type": "string", "format": "date-time"},
    "repository": {"const": "techno-optimist/p42-prizes"},
    "branch": {"const": "main"},
    "deployRelevantCommit": {"$ref": "#/$defs/commit"},
    "observedBranchHead": {"$ref": "#/$defs/commit"},
    "previousEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationCommit", "path", "observedBranchHead", "deployRelevantCommit", "evidenceHash"],
      "properties": {
        "publicationCommit": {"$ref": "#/$defs/commit"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "observedBranchHead": {"$ref": "#/$defs/commit"},
        "deployRelevantCommit": {"$ref": "#/$defs/commit"},
        "evidenceHash": {"$ref": "#/$defs/hash"}
      }
    },
    "trustPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "sha256"],
      "properties": {
        "policyId": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "workflowId", "workflowPath", "workflowBlobOid", "workflowSha256", "workflowClosureAlgorithm", "workflowClosureRoots", "workflowClosureManifest", "workflowClosureSha256", "runAttempt", "event", "branch", "runId", "url", "headSha", "status", "conclusion", "completedAt", "requiredJobs"],
      "properties": {
        "workflow": {"const": "CI"},
        "workflowId": {"type": "integer", "minimum": 1},
        "workflowPath": {"const": ".github/workflows/ci.yml"},
        "workflowBlobOid": {"$ref": "#/$defs/commit"},
        "workflowSha256": {"$ref": "#/$defs/hash"},
        "workflowClosureAlgorithm": {"const": "p42-git-ls-tree-closure/v1"},
        "workflowClosureRoots": {"const": ["."]},
        "workflowClosureManifest": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object",
            "oneOf": [
              {
                "additionalProperties": false,
                "required": ["kind", "path", "mode", "objectType", "objectOid"],
                "properties": {
                  "kind": {"const": "git-entry"},
                  "path": {"type": "string", "minLength": 1},
                  "mode": {"enum": ["100644", "100755", "120000", "160000"]},
                  "objectType": {"enum": ["blob", "commit"]},
                  "objectOid": {"$ref": "#/$defs/commit"}
                }
              },
              {
                "additionalProperties": false,
                "required": ["kind", "uses"],
                "properties": {
                  "kind": {"enum": ["external-action", "external-workflow", "container"]},
                  "uses": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        },
        "workflowClosureSha256": {"$ref": "#/$defs/hash"},
        "runAttempt": {"type": "integer", "minimum": 1},
        "event": {"const": "push"},
        "branch": {"const": "main"},
        "runId": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "pattern": "^https://github\\.com/techno-optimist/p42-prizes/actions/runs/[1-9][0-9]*$"},
        "headSha": {"$ref": "#/$defs/commit"},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "completedAt": {"type": "string", "format": "date-time"},
        "requiredJobs": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/job"}}
      }
    },
    "deployProvenance": {
      "$comment": "Current validation recursively re-derives and authenticates this interval for every predecessor v3 receipt before accepting its observed head as a baseline.",
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineObservedHead", "commits"],
      "properties": {
        "baselineObservedHead": {"$ref": "#/$defs/commit"},
        "commits": {"type": "array", "items": {"$ref": "#/$defs/sourceCommit"}}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceId", "deployId", "status", "trigger", "runtimeCommit", "liveCommit", "finishedAt"],
      "properties": {
        "serviceId": {"const": "srv-d96pokeq1p3s73foqk60"},
        "deployId": {"type": "string", "pattern": "^dep-[a-z0-9]+$"},
        "status": {"const": "live"},
        "trigger": {"enum": ["new_commit", "api"]},
        "runtimeCommit": {"$ref": "#/$defs/commit"},
        "liveCommit": {"$ref": "#/$defs/commit"},
        "finishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "releaseGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "boardProjection", "healthyRoutes", "requiredRoutes", "probes"],
      "properties": {
        "command": {"const": "node scripts/verify-render-release.mjs"},
        "status": {"const": "passed"},
        "boardProjection": {"$ref": "#/$defs/hash"},
        "healthyRoutes": {"const": 32},
        "requiredRoutes": {"const": 32},
        "probes": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"$ref": "#/$defs/probe"}}
      }
    },
    "portalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointSchema", "projectionSchema", "status", "failClosedPolicy", "liveFundingState"],
      "properties": {
        "checkpointSchema": {"const": "p42-prizes/indexer-checkpoint/v3"},
        "projectionSchema": {"const": "p42-prizes/portal-projection/v2"},
        "status": {"const": "source-complete-deployment-pending"},
        "failClosedPolicy": {"type": "string", "minLength": 32},
        "liveFundingState": {"type": "string", "minLength": 32}
      }
    },
    "evidenceHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "job": {
      "type": "object", "additionalProperties": false, "required": ["name", "conclusion"],
      "properties": {"name": {"type": "string", "minLength": 1}, "conclusion": {"const": "success"}}
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["routeId", "origin", "url", "status", "contentType", "finalUrl", "bodySha256"],
      "properties": {
        "routeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "origin": {"enum": ["render", "public"]},
        "url": {"type": "string", "format": "uri"},
        "status": {"const": 200},
        "contentType": {"type": "string", "minLength": 1},
        "finalUrl": {"type": "string", "format": "uri"},
        "bodySha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sourceCommit": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "firstParent", "tree", "changedPathsSha256", "authorization"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "firstParent": {"$ref": "#/$defs/commit"},
        "tree": {"$ref": "#/$defs/commit"},
        "changedPathsSha256": {"$ref": "#/$defs/hash"},
        "authorization": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "number", "url", "headSha", "mergeCommit"],
              "properties": {
                "type": {"const": "pull-request"}, "number": {"type": "integer", "minimum": 1},
                "url": {"type": "string", "format": "uri"}, "headSha": {"$ref": "#/$defs/commit"},
                "mergeCommit": {"$ref": "#/$defs/commit"}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "artifactType", "artifactSha256"],
              "properties": {
                "type": {"const": "bootstrap-ratification"},
                "artifactType": {"const": "p42-source-release-bootstrap-ratification/v1"},
                "artifactSha256": {"$ref": "#/$defs/hash"}
              }
            }
          ]
        }
      }
    }
  }
}
