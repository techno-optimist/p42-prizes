{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/capsule-rebuild-attestation.schema.json",
  "title": "P42 externally authorized capsule rebuild attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "generated_at_utc",
    "repository",
    "capsule",
    "build",
    "authority",
    "attestation_hash",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "p42-capsule-rebuild-attestation/v1" },
    "attestation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_uri",
        "deployment_commit",
        "evidence_commit",
        "object_format",
        "ancestry",
        "object_closure_algorithm",
        "object_closure_digest",
        "object_count"
      ],
      "properties": {
        "canonical_uri": { "const": "https://github.com/techno-optimist/p42-prizes" },
        "deployment_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "evidence_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "object_format": { "const": "sha1" },
        "ancestry": { "const": "deployment-ancestor-of-evidence" },
        "object_closure_algorithm": { "const": "git-rev-list-object-ids+sha256/v1" },
        "object_closure_digest": { "$ref": "#/$defs/digest" },
        "object_count": { "type": "integer", "minimum": 1 }
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes_sha256", "capsule_digest", "git_commit"],
      "properties": {
        "bytes_sha256": { "$ref": "#/$defs/digest" },
        "capsule_digest": { "$ref": "#/$defs/digest" },
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_info_digests",
        "contract_artifact_digests",
        "toolchain_image_digest",
        "policy"
      ],
      "properties": {
        "build_info_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "input_digest", "output_digest"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "input_digest": { "$ref": "#/$defs/digest" },
              "output_digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "contract_artifact_digests": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "artifact_digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "artifact_digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "toolchain_image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_access",
            "root_filesystem",
            "source_mount",
            "dependency_mount",
            "output_mount",
            "privileges",
            "legal_validator_execution"
          ],
          "properties": {
            "network_access": { "const": "denied" },
            "root_filesystem": { "const": "read-only" },
            "source_mount": { "const": "read-only" },
            "dependency_mount": { "const": "read-only" },
            "output_mount": { "const": "isolated-write-only" },
            "privileges": { "const": "none" },
            "legal_validator_execution": { "const": "forbidden" }
          }
        }
      }
    },
    "authority": { "$ref": "#/$defs/identity" },
    "attestation_hash": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "publicKey": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organization", "professional_email", "public_key"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 3 },
        "professional_email": { "type": "string", "format": "email" },
        "public_key": { "$ref": "#/$defs/publicKey" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "const": "capsule-build-authority" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/digest" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    }
  }
}
