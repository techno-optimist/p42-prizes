{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/production-release-verification.schema.json",
  "title": "P42 offline production release verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "sourceCommit", "generatedAt", "capsuleDigest", "slateDigest", "releaseIndexDigest", "ceremonyConfigDigest", "objectiveProofsActive", "admittedBoards", "verificationReportDigest"],
  "properties": {
    "schema": { "const": "p42-prizes/production-release-verification/v1" },
    "status": { "const": "verified" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "capsuleDigest": { "$ref": "#/$defs/digest" },
    "slateDigest": { "$ref": "#/$defs/digest" },
    "releaseIndexDigest": { "$ref": "#/$defs/digest" },
    "ceremonyConfigDigest": { "$ref": "#/$defs/digest" },
    "objectiveProofsActive": { "type": "boolean" },
    "verificationReportDigest": { "$ref": "#/$defs/digest" },
    "admittedBoards": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problemId", "problemSlug", "matrixDigest"],
        "properties": {
          "problemId": { "type": "string", "pattern": "^(?:[1-9]|10)$" },
          "problemSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "matrixDigest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
