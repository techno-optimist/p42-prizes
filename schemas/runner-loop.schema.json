{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/runner-loop-v1.json",
  "title": "P42 Runner Loop v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_utc",
    "iterations",
    "completed_jobs",
    "stop_reason",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p42-runner-loop/v1" },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "iterations": { "type": "integer", "minimum": 0 },
    "completed_jobs": { "type": "integer", "minimum": 0 },
    "stop_reason": {
      "enum": [
        "queue_empty",
        "max_iterations_reached",
        "max_jobs_reached",
        "unknown"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": true,
        "properties": {
          "kind": { "enum": ["completed", "wait"] },
          "job_id": { "type": ["string", "null"], "minLength": 1 },
          "status": { "enum": ["succeeded", "failed"] },
          "transcript_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "transcript_path": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] },
          "selected_job_id": { "type": ["string", "null"] },
          "queued_count": { "type": ["integer", "null"], "minimum": 0 },
          "active_running_count": { "type": ["integer", "null"], "minimum": 0 },
          "min_available_memory_mb": { "type": ["integer", "null"], "minimum": 0 },
          "memory": {
            "type": ["object", "null"],
            "required": ["total_mb", "available_mb", "swap_used_mb"],
            "additionalProperties": false,
            "properties": {
              "total_mb": { "type": "integer", "minimum": 0 },
              "available_mb": { "type": "integer", "minimum": 0 },
              "swap_used_mb": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
