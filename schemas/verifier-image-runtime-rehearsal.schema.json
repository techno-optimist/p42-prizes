{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.org/schemas/verifier-image-runtime-rehearsal.schema.json",
  "title": "P42 immutable verifier image runtime rehearsal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "completed_at_utc", "execution_nonce", "scope", "not_launch_evidence", "verifier_source_commit", "verifier_source_archive_digest", "release_config_commit", "release_config_archive_digest", "dossier_hash", "dossier_file_sha256", "publication_journal_hash", "board", "solution_sha256", "host", "image", "sandbox", "execution", "result", "rehearsal_hash"],
  "properties": {
    "schema_version": {"const": "p42-verifier-image-runtime-rehearsal/v2"},
    "completed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "execution_nonce": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "scope": {"const": "single-host-pull-rehearsal"},
    "not_launch_evidence": {"const": true},
    "verifier_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verifier_source_archive_digest": {"$ref": "#/$defs/digest"},
    "release_config_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_config_archive_digest": {"$ref": "#/$defs/digest"},
    "dossier_hash": {"$ref": "#/$defs/digest"},
    "dossier_file_sha256": {"$ref": "#/$defs/digest"},
    "publication_journal_hash": {"$ref": "#/$defs/digest"},
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "problem_id", "version", "source_hash"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "source_hash": {"$ref": "#/$defs/digest"}
      }
    },
    "solution_sha256": {"$ref": "#/$defs/digest"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker_info", "platform"],
      "properties": {
        "docker_info": {"type": "string", "minLength": 1},
        "platform": {"type": ["string", "null"], "enum": ["linux/amd64", "linux/arm64", null]}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable_reference", "index_digest", "local_image_id", "expected_config_digest", "repo_digests", "observed_provenance_labels", "expected_provenance_labels", "observed_runtime", "expected_runtime", "violations"],
      "properties": {
        "immutable_reference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
        "index_digest": {"$ref": "#/$defs/digest"},
        "local_image_id": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "expected_config_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "repo_digests": {"type": "array", "items": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"}, "uniqueItems": true},
        "observed_provenance_labels": {"anyOf": [{"type": "object", "additionalProperties": {"type": "string"}}, {"type": "null"}]},
        "expected_provenance_labels": {"anyOf": [{"$ref": "#/$defs/labels"}, {"type": "null"}]},
        "observed_runtime": {"$ref": "#/$defs/observedRuntime"},
        "expected_runtime": {"anyOf": [{"$ref": "#/$defs/runtime"}, {"type": "null"}]},
        "violations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "required_memory_mb", "memory_safety_factor", "memory_mb", "pids_limit", "cpus", "read_only_rootfs", "non_root_user"],
      "properties": {
        "network": {"const": "none"},
        "required_memory_mb": {"type": "integer", "minimum": 1},
        "memory_safety_factor": {"const": 2.0},
        "memory_mb": {"type": "integer", "minimum": 1},
        "pids_limit": {"type": "integer", "minimum": 1},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "read_only_rootfs": {"const": true},
        "non_root_user": {"const": "65534:65534"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "expected_returncodes", "timed_out", "failure_kind", "elapsed_ms", "stdout_sha256", "stderr_sha256", "verdict", "verdict_exit_contract_violations", "verdict_integrity_violations"],
      "properties": {
        "exit_code": {"type": "integer"},
        "expected_returncodes": {"type": "array", "minItems": 1, "items": {"type": "integer"}, "uniqueItems": true},
        "timed_out": {"type": "boolean"},
        "failure_kind": {"type": ["string", "null"], "enum": ["timeout", "stdout_limit_exceeded", "stderr_limit_exceeded", null]},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/digest"},
        "stderr_sha256": {"$ref": "#/$defs/digest"},
        "verdict": {"type": ["object", "null"]},
        "verdict_exit_contract_violations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "verdict_integrity_violations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable_pull_verified", "canonical_verdict_verified", "succeeded"],
      "properties": {
        "immutable_pull_verified": {"type": "boolean"},
        "canonical_verdict_verified": {"type": "boolean"},
        "succeeded": {"type": "boolean"}
      }
    },
    "rehearsal_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["org.opencontainers.image.revision", "io.projectforty2.verifier.source-sha256", "io.projectforty2.verifier.source-algorithm", "io.projectforty2.verifier.problem-id", "io.projectforty2.verifier.version"],
      "properties": {
        "org.opencontainers.image.revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "io.projectforty2.verifier.source-sha256": {"$ref": "#/$defs/digest"},
        "io.projectforty2.verifier.source-algorithm": {"const": "p42-source-tree-sha256/v2"},
        "io.projectforty2.verifier.problem-id": {"type": "string", "minLength": 1},
        "io.projectforty2.verifier.version": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "workdir", "entrypoint", "cmd"],
      "properties": {
        "user": {"enum": ["inherited-root-overridden-by-runner", "65534", "65534:65534"]},
        "workdir": {"type": "string", "pattern": "^/repo/problems/[a-z0-9][a-z0-9-]*$"},
        "entrypoint": {"type": "null"},
        "cmd": {"const": []}
      }
    },
    "observedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "workdir", "entrypoint", "cmd"],
      "properties": {
        "user": {"type": ["string", "null"]},
        "workdir": {"type": ["string", "null"]},
        "entrypoint": {"type": ["array", "string", "null"]},
        "cmd": {"type": ["array", "string", "null"]}
      }
    }
  }
}
