{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/runner-burst-v1.json",
  "title": "P42 Runner Burst Drill v1",
  "type": "object",
  "required": [
    "schema_version",
    "drill_id",
    "completed_at_utc",
    "environment",
    "agent_operator",
    "runner_host",
    "artifacts",
    "queue_policy",
    "burst_metrics",
    "loop_summary",
    "guard_cases",
    "invariants_checked",
    "regressions",
    "agent_attestation",
    "burst_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p42-runner-burst/v1" },
    "drill_id": { "type": "string", "minLength": 1 },
    "completed_at_utc": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["local-rehearsal", "dgx-dry-run", "base-sepolia"] },
    "agent_operator": { "type": "string", "minLength": 1 },
    "runner_host": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "object",
      "required": ["queue_before", "queue_after", "loop_summary", "transcript_archive", "alert_bundle"],
      "additionalProperties": false,
      "properties": {
        "queue_before": { "type": "string", "minLength": 1 },
        "queue_after": { "type": "string", "minLength": 1 },
        "loop_summary": { "type": "string", "minLength": 1 },
        "transcript_archive": { "type": "string", "minLength": 1 },
        "alert_bundle": { "type": "string", "minLength": 1 }
      }
    },
    "queue_policy": {
      "type": "object",
      "required": ["max_running", "reserve_memory_mb", "max_swap_used_mb", "memory_safety_factor"],
      "additionalProperties": false,
      "properties": {
        "max_running": { "const": 1 },
        "reserve_memory_mb": { "type": "integer", "minimum": 0 },
        "max_swap_used_mb": { "type": "integer", "minimum": 0 },
        "memory_safety_factor": { "type": "number", "minimum": 1 }
      }
    },
    "burst_metrics": {
      "type": "object",
      "required": [
        "submitted_jobs",
        "completed_jobs",
        "failed_jobs",
        "max_active_running",
        "max_observed_queue_depth",
        "oldest_queued_age_seconds",
        "oom_kills",
        "worker_restarts",
        "queue_corruption_events"
      ],
      "additionalProperties": false,
      "properties": {
        "submitted_jobs": { "type": "integer", "minimum": 3 },
        "completed_jobs": { "type": "integer", "minimum": 1 },
        "failed_jobs": { "type": "integer", "minimum": 0 },
        "max_active_running": { "const": 1 },
        "max_observed_queue_depth": { "type": "integer", "minimum": 2 },
        "oldest_queued_age_seconds": { "type": "integer", "minimum": 1 },
        "oom_kills": { "const": 0 },
        "worker_restarts": { "const": 0 },
        "queue_corruption_events": { "const": 0 }
      }
    },
    "loop_summary": {
      "type": "object",
      "required": ["schema_version", "generated_at_utc", "iterations", "completed_jobs", "stop_reason", "events"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "const": "p42-runner-loop/v1" },
        "generated_at_utc": { "type": "string", "minLength": 1 },
        "iterations": { "type": "integer", "minimum": 1 },
        "completed_jobs": { "type": "integer", "minimum": 1 },
        "stop_reason": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": true,
            "properties": {
              "kind": { "enum": ["completed", "wait"] },
              "job_id": { "type": ["string", "null"] },
              "reason": { "type": ["string", "null"] },
              "status": { "enum": ["succeeded", "failed"] }
            }
          }
        }
      }
    },
    "guard_cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "decision",
          "plan_reason",
          "queue_mutated",
          "started_verifier",
          "memory",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "decision": { "const": "wait" },
          "plan_reason": { "type": "string", "minLength": 1 },
          "queue_mutated": { "const": false },
          "started_verifier": { "const": false },
          "memory": {
            "type": "object",
            "required": ["total_mb", "available_mb", "swap_used_mb"],
            "additionalProperties": false,
            "properties": {
              "total_mb": { "type": "integer", "minimum": 0 },
              "available_mb": { "type": "integer", "minimum": 0 },
              "swap_used_mb": { "type": "integer", "minimum": 0 }
            }
          },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants_checked": {
      "type": "object",
      "required": [
        "fifo_order_preserved",
        "max_one_active_verifier",
        "low_memory_waited_without_mutation",
        "swap_guard_blocks_start",
        "host_capacity_blocks_start",
        "runner_slot_blocks_start",
        "transcripts_hash_validated",
        "alerts_generated_for_invalid",
        "no_secret_material_in_transcripts"
      ],
      "additionalProperties": false,
      "properties": {
        "fifo_order_preserved": { "const": true },
        "max_one_active_verifier": { "const": true },
        "low_memory_waited_without_mutation": { "const": true },
        "swap_guard_blocks_start": { "const": true },
        "host_capacity_blocks_start": { "const": true },
        "runner_slot_blocks_start": { "const": true },
        "transcripts_hash_validated": { "const": true },
        "alerts_generated_for_invalid": { "const": true },
        "no_secret_material_in_transcripts": { "const": true }
      }
    },
    "regressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" }
        }
      }
    },
    "agent_attestation": {
      "type": "object",
      "required": ["agent_operator", "signed_at_utc", "statement"],
      "additionalProperties": false,
      "properties": {
        "agent_operator": { "type": "string", "minLength": 1 },
        "signed_at_utc": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "burst_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
