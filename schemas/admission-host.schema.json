{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/admission-host-v1.json",
  "title": "P42 Admission Host Evidence v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_utc",
    "problem_id",
    "verifier_version",
    "verifier_image",
    "solution_hash",
    "report_hash",
    "run_hashes",
    "run_count",
    "host",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p42-admission-host/v1" },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "problem_id": { "type": "string", "minLength": 1 },
    "verifier_version": { "type": "string", "minLength": 1 },
    "verifier_image": { "type": "string", "minLength": 1 },
    "solution_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "report_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "run_hashes": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "run_count": { "type": "integer", "minimum": 2 },
    "host": {
      "type": "object",
      "required": [
        "label",
        "architecture",
        "os",
        "libc_name",
        "libc_version",
        "python_version"
      ],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "libc_name": { "type": "string", "minLength": 1 },
        "libc_version": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 }
      }
    },
    "report": {
      "type": "object",
      "required": [
        "problem_id",
        "verifier_version",
        "verifier_image",
        "solution_hash",
        "valid",
        "improvement",
        "score",
        "reason",
        "recomputed_at_commit",
        "details"
      ],
      "additionalProperties": false,
      "properties": {
        "problem_id": { "type": "string" },
        "verifier_version": { "type": "string" },
        "verifier_image": { "type": "string" },
        "solution_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "valid": { "type": "boolean" },
        "improvement": { "$ref": "#/$defs/rational" },
        "score": { "$ref": "#/$defs/rational" },
        "reason": { "type": "string" },
        "recomputed_at_commit": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "string",
      "pattern": "^-?[0-9]+/[1-9][0-9]*$"
    }
  }
}
