    "signature": {"type":"object","additionalProperties":false,"required":["algorithm","public_key","signature"],"properties":{"algorithm":{"const":"ed25519"},"public_key":{"type":"string","pattern":"^ed25519:[a-f0-9]{64}$"},"signature":{"type":"string","pattern":"^ed25519:[a-f0-9]{128}$"}}}
