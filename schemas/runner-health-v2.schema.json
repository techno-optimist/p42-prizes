        "archive_fault_history":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/archiveFaultHistory"}]},
        "runner_plan":{"type":"object","additionalProperties":false,"required":["decision","max_active_running","swap_guard","host_capacity","concurrency_guard"],"properties":{"decision":{"enum":["start","wait"]},"max_active_running":{"type":"integer","minimum":1,"maximum":9007199254740991},"swap_guard":{"enum":["green","red"]},"host_capacity":{"enum":["green","red"]},"concurrency_guard":{"enum":["green","red"]}}}
