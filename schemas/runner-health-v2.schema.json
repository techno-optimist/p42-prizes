pattern":"^sha256:[a-f0-9]{64}$"},"signature":{"type":"object","additionalProperties":false,"required":["algorithm","public_key","signature"],"properties":{"algorithm":{"const":"ed25519"},"public_key":{"type":"string","pattern":"^ed25519:[a-f0-9]{64}$"},"signature":{"type":"string","pattern":"^ed25519:[a-f0-9]{128}$"}}}}},
    "counterIncident":{"type":"object","additionalProperties":false,"required":["schema_version","generation","counters","scope","block_number","block_hash","block_time","artifact_hash","signature"],"properties":{"schema_version":{"const":"p42-runner-counter-incident/v1"},"generation":{"type":"integer","minimum":1,"maximum":9007199254740991},"counters":{"$ref":"#/$defs/counters"},"scope":{"type":"object","additionalProperties":false,"required":["health_public_key","host_id","boot_id","queue_id","chain_id","contract"],"properties":{"health_public_key":{"type":"string","pattern":"^ed25519:[a-f0-9]{64}$"},"host_id":{"type":"string","minLength":1},"boot_id":{"type":"string","minLength":1},"queue_id":{"type":"string","minLength":1},"chain_id":{"type":"integer","minimum":1,"maximum":9007199254740991},"contract":{"type":"string","pattern":"^0x[a-f0-9]{40}$"}}},"block_number":{"type":"integer","minimum":0,"maximum":9007199254740991},"block_hash":{"type":"string","pattern":"^0x[a-f0-9]{64}$"},"block_time":{"type":"integer","minimum":1,"maximum":9007199254740991},"artifact_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"signature":{"type":"object","additionalProperties":false,"required":["algorithm","public_key","signature"],"properties":{"algorithm":{"const":"ed25519"},"public_key":{"type":"string","pattern":"^ed25519:[a-f0-9]{64}$"},"signature":{"type":"string","pattern":"^ed25519:[a-f0-9]{128}$"}}}}},
