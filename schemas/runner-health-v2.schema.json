        "active_job_count":{"type":"integer","minimum":0,"maximum":9007199254740991}, "queued_job_count":{"type":"integer","minimum":0,"maximum":9007199254740991}, "ordinary_admission_headroom":{"type":"integer","minimum":0,"maximum":9007199254740991}, "urgent_admission_headroom":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "archive_record_count":{"type":"integer","minimum":0,"maximum":9007199254740991}, "tombstone_count":{"type":"integer","minimum":0,"maximum":9007199254740991}, "oldest_queued_age_seconds":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "earliest_live_deadline":{"type":["integer","null"],"minimum":1,"maximum":9007199254740991}, "minimum_challenge_slack_seconds":{"type":["integer","null"],"minimum":1,"maximum":9007199254740991}, "expired_deadline_critical_count":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "warning_slack_seconds":{"const":3600}, "critical_slack_seconds":{"const":900},
