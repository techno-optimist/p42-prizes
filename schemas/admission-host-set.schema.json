{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.org/schemas/admission-host-set.schema.json",
  "title": "P42 signed all-ten admission host set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "dossier", "fixtures", "host", "boards", "host_set_hash", "attestation"],
  "properties": {
    "schema_version": {"const": "p42-admission-host-set/v1"},
    "generated_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "dossier": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "dossier_hash", "source_commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/digest"},
        "dossier_hash": {"$ref": "#/$defs/digest"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "fixtures": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "board_set_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/digest"},
        "board_set_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "host": {"$ref": "#/$defs/host"},
    "boards": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slug", "fixture", "rehearsal_hashes", "evidence_path", "evidence_hash"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "fixture": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}
          },
          "rehearsal_hashes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
          "evidence_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.admission-host\\.json$"},
          "evidence_hash": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "host_set_hash": {"$ref": "#/$defs/digest"},
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "namespace", "public_key", "key_fingerprint", "signed_hash", "signature"],
      "properties": {
        "type": {"const": "ssh-ed25519"},
        "namespace": {"const": "p42-verifier-admission-v3"},
        "public_key": {"type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/=]+$"},
        "key_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]+$"},
        "signed_hash": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "pattern": "^-----BEGIN SSH SIGNATURE-----[\\s\\S]+-----END SSH SIGNATURE-----$"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "architecture", "os", "libc_name", "libc_version", "python_version"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "libc_name": {"type": "string", "minLength": 1},
        "libc_version": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
