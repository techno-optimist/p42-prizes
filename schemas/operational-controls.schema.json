{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/operational-controls-v2.json",
  "title": "P42 Gate 2 Operational Controls Evidence v1 historical or v2 production",
  "type": "object",
  "required": ["schema_version", "evidence_id", "window_started_at_utc", "window_completed_at_utc", "release_binding", "controls", "report_signer", "final_gate_claim", "operational_controls_hash", "report_signature"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "p42-operational-controls/v2" } } },
      "then": { "required": ["production_binding"] },
      "else": { "not": { "required": ["production_binding"] } }
    }
  ],
  "properties": {
    "schema_version": { "enum": ["p42-operational-controls/v1", "p42-operational-controls/v2"] },
    "evidence_id": { "type": "string", "minLength": 1 },
    "window_started_at_utc": { "type": "string", "format": "date-time" },
    "window_completed_at_utc": { "type": "string", "format": "date-time" },
    "release_binding": { "$ref": "#/$defs/releaseBinding" },
    "production_binding": { "$ref": "#/$defs/productionBinding" },
    "controls": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/control" }
    },
    "report_signer": { "$ref": "#/$defs/reportIdentity" },
    "final_gate_claim": { "const": "passed" },
    "operational_controls_hash": { "$ref": "#/$defs/hash" },
    "report_signature": { "$ref": "#/$defs/reportSignature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "publicKey": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["uri", "local_path", "sha256", "created_at_utc"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "sha256": { "$ref": "#/$defs/hash" },
        "created_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["name", "organization", "professional_email", "role", "public_key", "identity_evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 3 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "operational-control-owner" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "reportIdentity": {
      "type": "object",
      "required": ["name", "organization", "professional_email", "role", "public_key", "identity_evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 3 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "operational-controls-report-signer" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "const": "operational-control-owner" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/hash" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    },
    "reportSignature": {
      "type": "object",
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "const": "operational-controls-report-signer" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/hash" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    },
    "sessionDomain": {
      "type": "object",
      "required": ["chain_id", "contract_addresses", "problem_id"],
      "additionalProperties": false,
      "properties": {
        "chain_id": { "type": "integer", "minimum": 1 },
        "contract_addresses": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/address" } },
        "problem_id": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "required": ["class", "network", "chain_id", "git_commit", "release_binding_hash", "deployment_manifest_hash", "configuration_hash"],
      "additionalProperties": false,
      "properties": {
        "class": { "const": "production-equivalent" },
        "network": { "enum": ["base-sepolia", "base-mainnet"] },
        "chain_id": { "enum": [8453, 84532] },
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "release_binding_hash": { "$ref": "#/$defs/hash" },
        "deployment_manifest_hash": { "$ref": "#/$defs/hash" },
        "configuration_hash": { "$ref": "#/$defs/hash" },
        "session_domain": { "$ref": "#/$defs/sessionDomain" }
      }
    },
    "control": {
      "type": "object",
      "required": ["control", "status", "argv", "executed_at_utc", "environment", "test_artifact", "output_artifact", "owner", "control_hash", "owner_signature"],
      "additionalProperties": false,
      "properties": {
        "control": { "enum": ["mutation_api_auth", "distributed_rate_limit", "distributed_idempotency", "abuse_alerting", "payload_size_limit", "payload_quarantine", "malware_archive_bomb_rejection", "session_expiry", "session_revocation", "chain_contract_problem_scope_binding", "spend_cap_and_forbidden_actions"] },
        "status": { "const": "passed" },
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "executed_at_utc": { "type": "string", "format": "date-time" },
        "environment": { "$ref": "#/$defs/environment" },
        "test_artifact": { "$ref": "#/$defs/artifact" },
        "output_artifact": { "$ref": "#/$defs/artifact" },
        "owner": { "$ref": "#/$defs/identity" },
        "control_hash": { "$ref": "#/$defs/hash" },
        "owner_signature": { "$ref": "#/$defs/signature" }
      }
    },
    "contract": {
      "type": "object",
      "required": ["name", "address", "runtime_bytecode_hash", "source_artifact", "runtime_bytecode_artifact", "chain_bytecode_artifact"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["P42BountyPool", "P42PayoutLedger", "P42SubmissionManager", "P42ChallengeManager", "P42ProblemRegistry"] },
        "address": { "$ref": "#/$defs/address" },
        "runtime_bytecode_hash": { "$ref": "#/$defs/hash" },
        "source_artifact": { "$ref": "#/$defs/artifact" },
        "runtime_bytecode_artifact": { "$ref": "#/$defs/artifact" },
        "chain_bytecode_artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "legacyReleaseBinding": {
      "type": "object",
      "required": ["repository_uri", "git_commit", "network", "chain_id", "deployment_manifest", "configuration_artifact", "contracts"],
      "additionalProperties": false,
      "properties": {
        "repository_uri": { "type": "string", "pattern": "^https://" },
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "network": { "enum": ["base-sepolia", "base-mainnet"] },
        "chain_id": { "enum": [8453, 84532] },
        "deployment_manifest": { "$ref": "#/$defs/artifact" },
        "configuration_artifact": { "$ref": "#/$defs/artifact" },
        "contracts": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/contract" } }
      }
    },
    "canonicalContract": {
      "type": "object",
      "required": ["topology_key", "name", "address", "runtime_bytecode_hash", "manifest_runtime_code_hash", "source_artifact", "runtime_bytecode_artifact", "chain_bytecode_artifact"],
      "additionalProperties": false,
      "properties": {
        "topology_key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "runtime_bytecode_hash": { "$ref": "#/$defs/hash" },
        "manifest_runtime_code_hash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
        "source_artifact": { "$ref": "#/$defs/artifact" },
        "runtime_bytecode_artifact": { "$ref": "#/$defs/artifact" },
        "chain_bytecode_artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "canonicalReleaseBinding": {
      "type": "object",
      "required": ["binding_version", "repository_uri", "deployment_commit", "git_commit", "network", "chain_id", "canonical_topology", "release_capsule", "capsule_rebuild_attestation", "deployment_manifest", "configuration_artifact", "contracts"],
      "additionalProperties": false,
      "properties": {
        "binding_version": { "const": "p42-release-binding/v2" },
        "repository_uri": { "const": "https://github.com/techno-optimist/p42-prizes" },
        "deployment_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "network": { "const": "base-sepolia" },
        "chain_id": { "const": 84532 },
        "canonical_topology": { "$ref": "#/$defs/artifact" },
        "release_capsule": { "$ref": "#/$defs/artifact" },
        "capsule_rebuild_attestation": { "$ref": "#/$defs/artifact" },
        "deployment_manifest": { "$ref": "#/$defs/artifact" },
        "configuration_artifact": { "$ref": "#/$defs/artifact" },
        "contracts": { "type": "array", "minItems": 47, "maxItems": 47, "items": { "$ref": "#/$defs/canonicalContract" } }
      }
    },
    "releaseBinding": {
      "oneOf": [{ "$ref": "#/$defs/legacyReleaseBinding" }, { "$ref": "#/$defs/canonicalReleaseBinding" }]
    },
    "productionContractIdentity": {
      "type": "object",
      "required": ["topology_key", "name", "address", "runtime_bytecode_hash", "manifest_runtime_code_hash"],
      "additionalProperties": false,
      "properties": {
        "topology_key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "runtime_bytecode_hash": { "$ref": "#/$defs/hash" },
        "manifest_runtime_code_hash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" }
      }
    },
    "productionBinding": {
      "type": "object",
      "required": ["deployment_commit", "capsule_digest", "slate_digest", "config_digest", "release_binding_digest", "board_set_digest", "timelock_address", "treasury_address", "resolver_quorum_address", "contracts"],
      "additionalProperties": false,
      "properties": {
        "deployment_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "capsule_digest": { "$ref": "#/$defs/hash" },
        "slate_digest": { "$ref": "#/$defs/hash" },
        "config_digest": { "$ref": "#/$defs/hash" },
        "release_binding_digest": { "$ref": "#/$defs/hash" },
        "board_set_digest": { "$ref": "#/$defs/hash" },
        "timelock_address": { "$ref": "#/$defs/address" },
        "treasury_address": { "$ref": "#/$defs/address" },
        "resolver_quorum_address": { "$ref": "#/$defs/address" },
        "contracts": { "type": "array", "minItems": 47, "maxItems": 47, "items": { "$ref": "#/$defs/productionContractIdentity" } }
      }
    }
  }
}
