{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/governance-signoff-v1.json",
  "title": "P42 Governance Signoff v1",
  "type": "object",
  "required": [
    "schema_version",
    "signoff_id",
    "completed_at_utc",
    "network",
    "governance_owner",
    "security_owner",
    "treasury_multisig",
    "timelock",
    "pause_guardian",
    "custody_limits",
    "key_rotation",
    "recusal_policy",
    "rehearsal",
    "human_signoff",
    "governance_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p42-governance-signoff/v1" },
    "signoff_id": { "type": "string", "minLength": 1 },
    "completed_at_utc": { "type": "string", "minLength": 1 },
    "network": { "enum": ["base-sepolia", "base-mainnet"] },
    "governance_owner": { "type": "string", "minLength": 1 },
    "security_owner": { "type": "string", "minLength": 1 },
    "treasury_multisig": {
      "type": "object",
      "required": ["address", "threshold", "signers"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "threshold": { "type": "integer", "minimum": 3 },
        "signers": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["name", "address", "role", "recusal_acknowledged", "signed_at_utc"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
              "role": { "type": "string", "minLength": 1 },
              "recusal_acknowledged": { "const": true },
              "signed_at_utc": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "timelock": {
      "type": "object",
      "required": ["address", "min_delay_hours", "applies_to_upgrades", "applies_to_fee_changes"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "min_delay_hours": { "type": "integer", "minimum": 48 },
        "applies_to_upgrades": { "const": true },
        "applies_to_fee_changes": { "const": true }
      }
    },
    "pause_guardian": {
      "type": "object",
      "required": ["name", "address", "can_pause_new_submissions", "can_pause_claims", "can_redirect_funds"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "can_pause_new_submissions": { "const": true },
        "can_pause_claims": { "const": false },
        "can_redirect_funds": { "const": false }
      }
    },
    "custody_limits": {
      "type": "object",
      "required": [
        "pool_funds_redirectable",
        "finalized_claim_pauseable",
        "funded_verifier_mutable",
        "single_eoa_can_upgrade"
      ],
      "additionalProperties": false,
      "properties": {
        "pool_funds_redirectable": { "const": false },
        "finalized_claim_pauseable": { "const": false },
        "funded_verifier_mutable": { "const": false },
        "single_eoa_can_upgrade": { "const": false }
      }
    },
    "key_rotation": {
      "type": "object",
      "required": ["procedure", "evidence", "last_rehearsed_utc", "next_due_utc", "emergency_rotation_hours"],
      "additionalProperties": false,
      "properties": {
        "procedure": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "last_rehearsed_utc": { "type": "string", "minLength": 1 },
        "next_due_utc": { "type": "string", "minLength": 1 },
        "emergency_rotation_hours": { "type": "integer", "minimum": 1, "maximum": 24 }
      }
    },
    "recusal_policy": {
      "type": "object",
      "required": [
        "policy_path",
        "resolver_self_dispute_recusal",
        "p42_agent_affiliation_disclosure",
        "private_information_firewall"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_path": { "type": "string", "minLength": 1 },
        "resolver_self_dispute_recusal": { "const": true },
        "p42_agent_affiliation_disclosure": { "const": true },
        "private_information_firewall": { "const": true }
      }
    },
    "rehearsal": {
      "type": "object",
      "required": ["completed_at_utc", "scenario", "evidence", "regressions"],
      "additionalProperties": false,
      "properties": {
        "completed_at_utc": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "regressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "status"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "status": { "const": "passed" }
            }
          }
        }
      }
    },
    "human_signoff": {
      "type": "object",
      "required": ["governance_owner", "security_owner", "signed_at_utc", "statement"],
      "additionalProperties": false,
      "properties": {
        "governance_owner": { "type": "string", "minLength": 1 },
        "security_owner": { "type": "string", "minLength": 1 },
        "signed_at_utc": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "governance_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
