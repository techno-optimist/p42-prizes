{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/open-witness-collector-policy-v1.json",
  "title": "P42 open-witness collector authority policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "policy_id",
    "valid_from_utc",
    "valid_until_utc",
    "network",
    "rpc_quorum",
    "rpc_endpoints",
    "release_binding",
    "finality_confirmations",
    "authority_class",
    "authority_key_ids"
  ],
  "properties": {
    "schema_version": { "const": "p42-open-witness-collector-policy/v1" },
    "environment": { "enum": ["production", "test"] },
    "policy_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "valid_from_utc": { "type": "string", "format": "date-time" },
    "valid_until_utc": { "type": "string", "format": "date-time" },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chain_id"],
      "properties": {
        "name": { "const": "base-sepolia" },
        "chain_id": { "const": 84532 }
      }
    },
    "rpc_quorum": { "const": 2 },
    "rpc_endpoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/rpcEndpoint" }
    },
    "release_binding": { "$ref": "#/$defs/releaseBinding" },
    "finality_confirmations": { "type": "integer", "minimum": 12 },
    "authority_class": { "const": "p42-open-witness-collector-authority/v1" },
    "authority_key_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/keyId" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "keyId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{2,127}$" },
    "rpcEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "url"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "releaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "git_commit", "deployment_config_hash"],
      "properties": {
        "manifest_path": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "deployment_config_hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
      }
    }
  }
}
