{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/incident-drill-v2.json",
  "title": "P42 Incident Drill v2",
  "type": "object",
  "required": [
    "schema_version",
    "drill_id",
    "started_at_utc",
    "completed_at_utc",
    "environment",
    "severity",
    "scenario",
    "release_binding",
    "facilitator",
    "incident_lead",
    "comms_owner",
    "security_owner",
    "external_counsel",
    "disclosure_probe_operator",
    "affected_scope",
    "evidence_preserved",
    "timeline",
    "decisions",
    "invariants_checked",
    "regressions",
    "communications",
    "bug_bounty",
    "open_followups",
    "human_signoff",
    "attestations",
    "drill_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p42-incident-drill/v2" },
    "drill_id": { "type": "string", "minLength": 1 },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "completed_at_utc": { "type": "string", "format": "date-time" },
    "environment": { "enum": ["tabletop", "base-sepolia", "production"] },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "scenario": {
      "enum": [
        "api_abuse",
        "chain_reorg",
        "contract_loss",
        "da_outage",
        "key_compromise",
        "resolver_misbehavior",
        "verifier_bug"
      ]
    },
    "release_binding": {
      "$ref": "https://p42.xyz/schemas/adversarial-campaign-v2.json#/$defs/releaseBinding"
    },
    "facilitator": { "$ref": "#/$defs/facilitator" },
    "incident_lead": { "$ref": "#/$defs/incidentLead" },
    "comms_owner": { "$ref": "#/$defs/commsOwner" },
    "security_owner": { "$ref": "#/$defs/securityOwner" },
    "external_counsel": { "$ref": "#/$defs/externalCounsel" },
    "disclosure_probe_operator": { "$ref": "#/$defs/disclosureProbeOperator" },
    "affected_scope": { "type": "string", "minLength": 1 },
    "evidence_preserved": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "timeline": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["time_utc", "event", "owner_role"],
        "additionalProperties": false,
        "properties": {
          "time_utc": { "type": "string", "format": "date-time" },
          "event": { "type": "string", "minLength": 1 },
          "owner_role": { "$ref": "#/$defs/incidentRole" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["decided_at_utc", "decision", "rationale", "owner_role"],
        "additionalProperties": false,
        "properties": {
          "decided_at_utc": { "type": "string", "format": "date-time" },
          "decision": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "owner_role": { "$ref": "#/$defs/incidentRole" }
        }
      }
    },
    "invariants_checked": {
      "type": "object",
      "required": [
        "claim_not_paused",
        "resolver_transcript_required",
        "problem_scope_isolated",
        "public_copy_testnet_vs_eth_checked",
        "evidence_preservation_complete"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_not_paused": { "const": true },
        "resolver_transcript_required": { "const": true },
        "problem_scope_isolated": { "const": true },
        "public_copy_testnet_vs_eth_checked": { "const": true },
        "evidence_preservation_complete": { "const": true }
      }
    },
    "regressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_artifact", "output_artifact", "status", "command", "executed_at_utc"],
        "additionalProperties": false,
        "properties": {
          "test_artifact": { "$ref": "#/$defs/artifact" },
          "output_artifact": { "$ref": "#/$defs/artifact" },
          "status": { "const": "passed" },
          "command": { "type": "string", "minLength": 1 },
          "executed_at_utc": { "type": "string", "format": "date-time" }
        }
      }
    },
    "communications": {
      "type": "object",
      "required": ["initial_status_draft", "status_channel", "postmortem_owner_role"],
      "additionalProperties": false,
      "properties": {
        "initial_status_draft": { "type": "string", "minLength": 1 },
        "status_channel": { "type": "string", "pattern": "^https://" },
        "postmortem_owner_role": { "$ref": "#/$defs/incidentRole" }
      }
    },
    "bug_bounty": {
      "type": "object",
      "required": [
        "status",
        "policy_artifact",
        "public_policy_uri",
        "private_reporting_uri",
        "disclosure_contact",
        "triage_sla_hours",
        "bounty_owner_role",
        "scope_summary",
        "counsel_approved_at_utc",
        "activated_at_utc",
        "activation_evidence",
        "external_probe_receipts"
      ],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "active" },
        "policy_artifact": { "$ref": "#/$defs/artifact" },
        "public_policy_uri": { "type": "string", "pattern": "^https://" },
        "private_reporting_uri": { "type": "string", "pattern": "^https://" },
        "disclosure_contact": { "type": "string", "format": "email" },
        "triage_sla_hours": { "type": "integer", "minimum": 1, "maximum": 72 },
        "bounty_owner_role": { "const": "security-owner" },
        "scope_summary": { "type": "string", "minLength": 1 },
        "counsel_approved_at_utc": { "type": "string", "format": "date-time" },
        "activated_at_utc": { "type": "string", "format": "date-time" },
        "activation_evidence": { "$ref": "#/$defs/artifact" },
        "external_probe_receipts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/probeReceipt" }
        }
      }
    },
    "open_followups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "owner_role", "due_utc", "severity"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "owner_role": { "$ref": "#/$defs/incidentRole" },
          "due_utc": { "type": "string", "format": "date-time" },
          "severity": { "enum": ["medium", "low"] }
        }
      }
    },
    "human_signoff": {
      "type": "object",
      "required": [
        "security_owner_name",
        "facilitator_name",
        "external_counsel_name",
        "security_owner_signed_at_utc",
        "facilitator_signed_at_utc",
        "external_counsel_signed_at_utc",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "security_owner_name": { "type": "string", "minLength": 3 },
        "facilitator_name": { "type": "string", "minLength": 3 },
        "external_counsel_name": { "type": "string", "minLength": 3 },
        "security_owner_signed_at_utc": { "type": "string", "format": "date-time" },
        "facilitator_signed_at_utc": { "type": "string", "format": "date-time" },
        "external_counsel_signed_at_utc": { "type": "string", "format": "date-time" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "attestations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/signature" }
    },
    "drill_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "publicKey": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "incidentRole": {
      "enum": ["facilitator", "incident-lead", "communications-owner", "security-owner"]
    },
    "artifact": {
      "type": "object",
      "required": ["uri", "local_path", "sha256", "created_at_utc"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "sha256": { "$ref": "#/$defs/hash" },
        "created_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "facilitator": { "$ref": "#/$defs/facilitatorIdentity" },
    "facilitatorIdentity": {
      "type": "object",
      "required": ["name", "organization", "professional_email", "role", "public_key", "identity_evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 2 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "facilitator" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "incidentLead": {
      "type": "object",
      "required": ["name", "organization", "professional_email", "role", "public_key", "identity_evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 2 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "incident-lead" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "commsOwner": {
      "type": "object",
      "required": ["name", "organization", "professional_email", "role", "public_key", "identity_evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 2 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "communications-owner" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "securityOwner": {
      "type": "object",
      "required": ["name", "organization", "professional_email", "role", "public_key", "identity_evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 2 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "security-owner" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" }
      }
    },
    "externalCounsel": {
      "type": "object",
      "required": [
        "name",
        "organization",
        "professional_email",
        "role",
        "public_key",
        "identity_evidence",
        "independent_from_p42",
        "bar_jurisdiction",
        "license_identifier"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 2 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "external-counsel" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" },
        "independent_from_p42": { "const": true },
        "bar_jurisdiction": { "type": "string", "minLength": 2 },
        "license_identifier": { "type": "string", "minLength": 4 }
      }
    },
    "disclosureProbeOperator": {
      "type": "object",
      "required": [
        "name",
        "organization",
        "professional_email",
        "role",
        "public_key",
        "identity_evidence",
        "independent_from_p42"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 2 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "external-disclosure-probe-operator" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" },
        "independent_from_p42": { "const": true }
      }
    },
    "probeReceipt": {
      "type": "object",
      "required": [
        "receipt_type",
        "target",
        "outcome",
        "policy_sha256",
        "observed_at_utc",
        "evidence",
        "receipt_hash",
        "operator_signature"
      ],
      "additionalProperties": false,
      "properties": {
        "receipt_type": {
          "enum": ["public_disclosure_route", "private_advisory_delivery", "mailbox_receipt"]
        },
        "target": { "type": "string", "minLength": 3 },
        "outcome": { "const": "confirmed" },
        "policy_sha256": { "$ref": "#/$defs/hash" },
        "observed_at_utc": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/artifact" },
        "receipt_hash": { "$ref": "#/$defs/hash" },
        "operator_signature": { "$ref": "#/$defs/probeSignature" }
      }
    },
    "probeSignature": {
      "type": "object",
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "const": "external-disclosure-probe-operator" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/hash" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "enum": ["security-owner", "facilitator", "external-counsel"] },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/hash" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    }
  }
}
