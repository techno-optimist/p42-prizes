{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/indexer-checkpoint-v2.schema.json",
  "title": "P42 Prizes deterministic multi-board indexer checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestBinding", "finalityPolicy", "range", "boards", "reconstruction"],
  "properties": {
    "schema": { "const": "p42-prizes/indexer-checkpoint/v2" },
    "manifestBinding": { "$ref": "#/$defs/manifestBinding" },
    "finalityPolicy": { "$ref": "#/$defs/finalityPolicy" },
    "range": { "$ref": "#/$defs/range" },
    "boards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/board" }
    },
    "reconstruction": { "$ref": "#/$defs/reconstruction" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "integerString": { "type": "string", "pattern": "^-?[0-9]+$" },
    "positiveUintString": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "problemSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "logIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "eventName", "contractAddress", "blockNumber", "blockHash", "transactionHash", "transactionIndex", "logIndex"],
      "properties": {
        "source": { "type": "string", "minLength": 1 }, "eventName": { "type": "string", "minLength": 1 },
        "contractAddress": { "$ref": "#/$defs/address" },
        "blockNumber": { "type": "integer", "minimum": 0 }, "blockHash": { "$ref": "#/$defs/bytes32" },
        "transactionHash": { "$ref": "#/$defs/bytes32" }, "transactionIndex": { "type": "integer", "minimum": 0 },
        "logIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "openWitnessLaunchEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "collector_authoritative", "releaseBinding", "artifactBinding", "registryTuple", "submission", "funding", "finalizedEvidence"],
      "properties": {
        "schema": { "const": "p42-prizes/open-witness-launch-evidence/v1" },
        "collector_authoritative": { "const": true },
        "releaseBinding": { "type": "object" },
        "artifactBinding": { "type": "object" },
        "registryTuple": { "type": "object" },
        "submission": {
          "type": "object", "additionalProperties": false,
          "required": ["submissionId", "solver", "paidAtCommit", "commitDaHash", "solutionCid", "logs", "frontier", "creditAtoms", "creditRecorded", "ledgerDeltaAtoms", "nonvoidCanonicalFinalize"],
          "properties": {
            "submissionId": { "$ref": "#/$defs/positiveUintString" }, "solver": { "$ref": "#/$defs/address" },
            "paidAtCommit": { "const": false }, "commitDaHash": { "$ref": "#/$defs/bytes32" }, "solutionCid": { "type": "string", "minLength": 1 },
            "logs": { "type": "object", "additionalProperties": false, "required": ["commit", "reveal", "finalize"], "properties": { "commit": { "$ref": "#/$defs/logIdentity" }, "reveal": { "$ref": "#/$defs/logIdentity" }, "finalize": { "$ref": "#/$defs/logIdentity" } } },
            "frontier": { "type": "object", "additionalProperties": false, "required": ["previousAtoms", "currentAtoms"], "properties": { "previousAtoms": { "$ref": "#/$defs/integerString" }, "currentAtoms": { "$ref": "#/$defs/integerString" } } },
            "creditAtoms": { "const": "0" }, "creditRecorded": { "const": false }, "ledgerDeltaAtoms": { "const": "0" }, "nonvoidCanonicalFinalize": { "const": true }
          }
        },
        "funding": {
          "type": "object", "additionalProperties": false,
          "required": ["armedAfterFinalize", "armLog", "poolBalanceBeforeArmWei", "acceptingFundsBeforeArm", "beforeArmStorageBlock"],
          "properties": {
            "armedAfterFinalize": { "const": true }, "armLog": { "$ref": "#/$defs/logIdentity" },
            "poolBalanceBeforeArmWei": { "const": "0" }, "acceptingFundsBeforeArm": { "const": false },
            "beforeArmStorageBlock": { "type": "object", "additionalProperties": false, "required": ["blockNumber", "blockHash"], "properties": { "blockNumber": { "type": "integer", "minimum": 0 }, "blockHash": { "$ref": "#/$defs/bytes32" } } }
          }
        },
        "finalizedEvidence": { "type": "object", "additionalProperties": false, "required": ["blockNumber", "blockHash"], "properties": { "blockNumber": { "type": "integer", "minimum": 0 }, "blockHash": { "$ref": "#/$defs/bytes32" } } }
      }
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "deployedCodeHash", "abiHash"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "deployedCodeHash": { "$ref": "#/$defs/bytes32" },
        "abiHash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "boardContractBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "ledger", "submissions", "challenges"],
      "properties": {
        "pool": { "$ref": "#/$defs/contractBinding" },
        "ledger": { "$ref": "#/$defs/contractBinding" },
        "submissions": { "$ref": "#/$defs/contractBinding" },
        "challenges": { "$ref": "#/$defs/contractBinding" }
      }
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentCommit", "deploymentConfigHash", "chainId", "startBlock", "contracts", "boards"],
      "properties": {
        "deploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "deploymentConfigHash": { "$ref": "#/$defs/bytes32" },
        "chainId": { "type": "integer", "minimum": 1 },
        "startBlock": { "type": "integer", "minimum": 0 },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timelock", "registry"],
          "properties": {
            "timelock": { "$ref": "#/$defs/contractBinding" },
            "registry": { "$ref": "#/$defs/contractBinding" }
          }
        },
        "boards": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/boardContractBindings" }
        }
      }
    },
    "finalityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "confirmations", "logChunkSize", "reorgOverlapBlocks", "maxRetries", "retryBaseDelayMs", "maxScanRestarts"],
      "properties": {
        "mode": { "const": "confirmations" },
        "confirmations": { "type": "integer", "minimum": 1 },
        "logChunkSize": { "type": "integer", "minimum": 2 },
        "reorgOverlapBlocks": { "type": "integer", "minimum": 1 },
        "maxRetries": { "type": "integer", "minimum": 1 },
        "retryBaseDelayMs": { "type": "integer", "minimum": 0 },
        "maxScanRestarts": { "type": "integer", "minimum": 1 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromBlock", "toBlock", "toBlockHash"],
      "properties": {
        "fromBlock": { "type": "integer", "minimum": 0 },
        "toBlock": { "type": "integer", "minimum": 0 },
        "toBlockHash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "total", "counts", "lifecycleCountsComplete"],
      "properties": {
        "digest": { "$ref": "#/$defs/bytes32" },
        "total": { "type": "integer", "minimum": 0 },
        "counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "lifecycleCountsComplete": { "type": "boolean" }
      }
    },
    "onchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionCount", "openSubmissionCount", "bestScoreAtoms", "poolFirstFundedAt", "ledgerPausedNewActions", "submissionsPausedNewActions", "submissionsPausedAll", "submissionExpiryGraceUntil", "challengePausedNewActions", "registryProblemCount", "registryFrozen"],
      "properties": {
        "submissionCount": { "$ref": "#/$defs/integerString" },
        "openSubmissionCount": { "$ref": "#/$defs/integerString" },
        "bestScoreAtoms": { "$ref": "#/$defs/integerString" },
        "poolFirstFundedAt": { "$ref": "#/$defs/integerString" },
        "ledgerPausedNewActions": { "type": "boolean" },
        "submissionsPausedNewActions": { "type": "boolean" },
        "submissionsPausedAll": { "type": "boolean" },
        "submissionExpiryGraceUntil": { "$ref": "#/$defs/integerString" },
        "challengePausedNewActions": { "type": "boolean" },
        "registryProblemCount": { "$ref": "#/$defs/integerString" },
        "registryFrozen": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ok", "expected", "actual"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "expected": {},
        "actual": {}
      }
    },
    "boardReconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "complete", "lifecycleSnapshotComplete", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "lifecycleSnapshotComplete": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "complete", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problemId", "problemSlug", "events", "onchain", "state", "reconstruction"],
      "properties": {
        "problemId": { "$ref": "#/$defs/positiveUintString" },
        "problemSlug": { "$ref": "#/$defs/problemSlug" },
        "events": { "$ref": "#/$defs/events" },
        "onchain": { "$ref": "#/$defs/onchain" },
        "state": { "type": "object" },
        "reconstruction": { "$ref": "#/$defs/boardReconstruction" },
        "openWitnessLaunchEvidence": { "$ref": "#/$defs/openWitnessLaunchEvidence" }
      }
    }
  }
}
