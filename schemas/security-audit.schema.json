{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/schemas/security-audit-v2.json",
  "title": "P42 External Security Audit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "status",
    "completed_at_utc",
    "audited_organization",
    "release_binding",
    "auditor",
    "engagement_identifier",
    "engagement_artifact",
    "audit_report",
    "findings_register",
    "scope",
    "contracts_reviewed",
    "findings",
    "security_owner",
    "residual_risk_acceptance",
    "audit_hash",
    "auditor_signature",
    "security_owner_signature"
  ],
  "properties": {
    "schema_version": { "const": "p42-security-audit/v2" },
    "audit_id": { "type": "string", "minLength": 1 },
    "status": { "const": "passed" },
    "completed_at_utc": { "type": "string", "format": "date-time" },
    "audited_organization": { "type": "string", "minLength": 3 },
    "release_binding": {
      "$ref": "https://p42.xyz/schemas/adversarial-campaign-v2.json#/$defs/releaseBinding"
    },
    "auditor": { "$ref": "#/$defs/auditor" },
    "engagement_identifier": { "type": "string", "minLength": 5 },
    "engagement_artifact": { "$ref": "#/$defs/artifact" },
    "audit_report": { "$ref": "#/$defs/artifact" },
    "findings_register": { "$ref": "#/$defs/artifact" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_soundness_and_determinism",
        "commit_reveal_and_data_availability",
        "challenge_resolver_finality",
        "payout_claim_bond_and_economic_transitions",
        "api_and_local_persistence_concurrency",
        "event_chain_integrity",
        "agent_wallet_and_session_scoping",
        "key_governance_pause_custody_recovery_and_cancellation",
        "reconciliation",
        "evidence_forgery",
        "source_deployment_consistency",
        "upgrade_or_immutability_assumptions",
        "denial_of_service"
      ],
      "properties": {
        "verifier_soundness_and_determinism": { "const": true },
        "commit_reveal_and_data_availability": { "const": true },
        "challenge_resolver_finality": { "const": true },
        "payout_claim_bond_and_economic_transitions": { "const": true },
        "api_and_local_persistence_concurrency": { "const": true },
        "event_chain_integrity": { "const": true },
        "agent_wallet_and_session_scoping": { "const": true },
        "key_governance_pause_custody_recovery_and_cancellation": { "const": true },
        "reconciliation": { "const": true },
        "evidence_forgery": { "const": true },
        "source_deployment_consistency": { "const": true },
        "upgrade_or_immutability_assumptions": { "const": true },
        "denial_of_service": { "const": true }
      }
    },
    "contracts_reviewed": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "items": { "$ref": "#/$defs/contractReview" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "security_owner": { "$ref": "#/$defs/securityOwner" },
    "residual_risk_acceptance": { "$ref": "#/$defs/artifact" },
    "audit_hash": { "$ref": "#/$defs/hash" },
    "auditor_signature": { "$ref": "#/$defs/auditorSignature" },
    "security_owner_signature": { "$ref": "#/$defs/securityOwnerSignature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "publicKey": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "artifact": {
      "$ref": "https://p42.xyz/schemas/adversarial-campaign-v2.json#/$defs/artifact"
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "organization",
        "professional_email",
        "role",
        "public_key",
        "identity_evidence",
        "independent_from_p42",
        "signed_at_utc"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 3 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "external-security-auditor" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" },
        "independent_from_p42": { "const": true },
        "signed_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "securityOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "organization",
        "professional_email",
        "role",
        "public_key",
        "identity_evidence",
        "signed_at_utc"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "organization": { "type": "string", "minLength": 3 },
        "professional_email": { "type": "string", "format": "email" },
        "role": { "const": "security-owner" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "identity_evidence": { "$ref": "#/$defs/artifact" },
        "signed_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "contractReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology_key", "name", "address", "source_sha256", "runtime_bytecode_hash"],
      "properties": {
        "topology_key": {
          "type": "string",
          "pattern": "^(?:shared\\.(?:timelock|registry|rolloverVault|submissionManagerFactory|challengeManagerFactory|objectiveVerifier|resolverQuorum)|board\\.(?:[1-9]|10)\\.(?:pool|ledger|submissions|challenges))$"
        },
        "name": {
          "enum": [
            "P42MultisigTimelock",
            "P42ProblemRegistry",
            "P42RolloverVault",
            "P42SubmissionManagerFactory",
            "P42ChallengeManagerFactory",
            "P42SP1VerifierGateway",
            "P42ResolverQuorum",
            "P42BountyPool",
            "P42PayoutLedger",
            "P42SubmissionManager",
            "P42ChallengeManager"
          ]
        },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "source_sha256": { "$ref": "#/$defs/hash" },
        "runtime_bytecode_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "title", "severity", "affected_code", "recommendation", "disposition", "residual_risk"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
        "affected_code": { "type": "string", "minLength": 3 },
        "recommendation": { "type": "string", "minLength": 3 },
        "disposition": { "enum": ["resolved", "accepted", "open"] },
        "residual_risk": { "type": "string", "minLength": 3 },
        "remediation_commits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        },
        "retest_artifact": { "$ref": "#/$defs/artifact" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": { "const": "resolved" },
              "severity": { "enum": ["critical", "high", "medium", "low"] }
            },
            "required": ["disposition", "severity"]
          },
          "then": {
            "required": ["remediation_commits", "retest_artifact"]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": { "const": "resolved" },
              "severity": { "const": "informational" }
            },
            "required": ["disposition", "severity"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["remediation_commits"] },
                { "required": ["retest_artifact"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "accepted" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "severity": { "enum": ["medium", "low", "informational"] } },
            "not": {
              "anyOf": [
                { "required": ["remediation_commits"] },
                { "required": ["retest_artifact"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "open" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "severity": { "const": "informational" } },
            "not": {
              "anyOf": [
                { "required": ["remediation_commits"] },
                { "required": ["retest_artifact"] }
              ]
            }
          }
        }
      ]
    },
    "auditorSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "const": "external-security-auditor" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/hash" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    },
    "securityOwnerSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signer_role", "public_key", "signed_hash", "signed_at_utc", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer_role": { "const": "security-owner" },
        "public_key": { "$ref": "#/$defs/publicKey" },
        "signed_hash": { "$ref": "#/$defs/hash" },
        "signed_at_utc": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^ed25519:[a-f0-9]{128}$" }
      }
    }
  }
}
