{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/release-capsule.schema.json",
  "title": "P42 closed production contract release capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gitCommit", "contracts", "externalDependencies", "buildInfos", "capsuleDigest"],
  "properties": {
    "schema": { "const": "p42-prizes/release-capsule/v2" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "capsuleDigest": { "$ref": "#/$defs/digest" },
    "contracts": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/timelock" }, { "$ref": "#/$defs/challengeFactory" }, { "$ref": "#/$defs/submissionFactory" }, { "$ref": "#/$defs/rollover" }, { "$ref": "#/$defs/sp1Gateway" }, { "$ref": "#/$defs/quorum" }, { "$ref": "#/$defs/pool" }, { "$ref": "#/$defs/ledger" }, { "$ref": "#/$defs/submissions" }, { "$ref": "#/$defs/challenges" }, { "$ref": "#/$defs/registry" }], "items": false },
    "externalDependencies": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/sp1Dependency" }], "items": false },
    "buildInfos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/buildInfo" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hex": { "type": "string", "pattern": "^0x(?:[0-9a-f]{2})*$" },
    "range": { "type": "object", "additionalProperties": false, "required": ["start", "length"], "properties": { "start": { "type": "integer", "minimum": 0 }, "length": { "type": "integer", "minimum": 1 } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["astId", "name", "type", "ranges"], "properties": { "astId": { "type": "string", "pattern": "^[0-9]+$" }, "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "ranges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/range" } } } },
    "immutableReferences": { "type": "object", "propertyNames": { "pattern": "^[0-9]+$" }, "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/range" } } },
    "deployment": { "type": "object", "additionalProperties": false, "required": ["chainId", "address", "descriptorPath", "descriptorDigest"], "properties": { "chainId": { "enum": ["8453", "84532"] }, "address": { "const": "0xb69f2584cbcff99a58c4e7002e8b89af54a6f4e2" }, "descriptorPath": { "enum": ["contracts/deployments/8453.json", "contracts/deployments/84532.json"] }, "descriptorDigest": { "$ref": "#/$defs/digest" } } },
    "sp1Dependency": { "type": "object", "additionalProperties": false, "required": ["name", "repository", "releaseTag", "commit", "license", "interfaceSignature", "interfaceSelector", "runtimeCodehash", "deployments"], "properties": { "name": { "const": "SP1VerifierGroth16V6_1_0" }, "repository": { "const": "https://github.com/succinctlabs/sp1-contracts" }, "releaseTag": { "const": "v6.1.0" }, "commit": { "const": "2ac5ecbbe473421a963d67e55f182e9a36576f7c" }, "license": { "const": "MIT" }, "interfaceSignature": { "const": "verifyProof(bytes32,bytes,bytes)" }, "interfaceSelector": { "const": "0x41493c60" }, "runtimeCodehash": { "const": "0xcceb864cd8a5a36b2073a8f2b32a773835cd2dd2c78a56f8e6fdb942feff04dd" }, "deployments": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/deployment" }, { "$ref": "#/$defs/deployment" }], "items": false } } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["name", "sourceName", "buildInfoId", "artifactDigest", "abi", "creationCode", "runtimeTemplate", "immutableReferences", "immutableBindings", "linkReferences", "deployedLinkReferences"], "properties": { "name": { "enum": ["P42MultisigTimelock", "P42ChallengeManagerFactory", "P42SubmissionManagerFactory", "P42RolloverVault", "P42SP1VerifierGateway", "P42ResolverQuorum", "P42BountyPool", "P42PayoutLedger", "P42SubmissionManager", "P42ChallengeManager", "P42ProblemRegistry"] }, "sourceName": { "type": "string", "pattern": "^src/P42[^/]+\\.sol$" }, "buildInfoId": { "type": "string", "minLength": 1 }, "artifactDigest": { "$ref": "#/$defs/digest" }, "abi": { "type": "array" }, "creationCode": { "$ref": "#/$defs/hex" }, "runtimeTemplate": { "$ref": "#/$defs/hex" }, "immutableReferences": { "$ref": "#/$defs/immutableReferences" }, "immutableBindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } }, "linkReferences": { "type": "object", "maxProperties": 0 }, "deployedLinkReferences": { "type": "object", "maxProperties": 0 } } },
    "timelock": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42MultisigTimelock" } } }] },
    "challengeFactory": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42ChallengeManagerFactory" } } }] },
    "submissionFactory": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42SubmissionManagerFactory" } } }] },
    "rollover": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42RolloverVault" } } }] },
    "sp1Gateway": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42SP1VerifierGateway" } } }] },
    "quorum": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42ResolverQuorum" } } }] },
    "pool": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42BountyPool" } } }] },
    "ledger": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42PayoutLedger" } } }] },
    "submissions": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42SubmissionManager" } } }] },
    "challenges": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42ChallengeManager" } } }] },
    "registry": { "allOf": [{ "$ref": "#/$defs/contract" }, { "properties": { "name": { "const": "P42ProblemRegistry" } } }] },
    "buildInfo": { "type": "object", "additionalProperties": false, "required": ["id", "inputDigest", "outputDigest", "compiler", "settings", "input", "output"], "properties": { "id": { "type": "string", "minLength": 1 }, "inputDigest": { "$ref": "#/$defs/digest" }, "outputDigest": { "$ref": "#/$defs/digest" }, "compiler": { "type": "object", "additionalProperties": false, "required": ["version", "longVersion"], "properties": { "version": { "const": "0.8.24" }, "longVersion": { "const": "0.8.24+commit.e11b9ed9" } } }, "settings": { "type": "object", "description": "Exact compiler settings value, closed by canonical digest and equality to input.input.settings." }, "input": { "type": "object", "description": "Canonical opaque Hardhat compiler-input document; duplicate keys are rejected before construction and inputDigest closes the complete value." }, "output": { "type": "object", "description": "Canonical opaque Hardhat compiler-output document including the solc AST; duplicate keys are rejected before construction and outputDigest closes the complete value." } } }
  }
}
