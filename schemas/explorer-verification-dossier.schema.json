{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/explorer-verification-dossier.schema.json",
  "title": "P42 raw-response explorer verification dossier",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "chainId", "releaseBindingDigest", "capsuleDigest", "deploymentCommit", "finalizedAt", "expiresAt", "contracts", "evidenceDigest", "operatorRoster", "attestations", "dossierDigest"],
  "properties": {
    "schema": { "const": "p42-prizes/explorer-verification-dossier/v2" }, "chainId": { "const": 84532 },
    "releaseBindingDigest": { "$ref": "#/$defs/digest" }, "capsuleDigest": { "$ref": "#/$defs/digest" }, "deploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "finalizedAt": { "type": "integer", "minimum": 1 }, "expiresAt": { "type": "integer", "minimum": 1 },
    "contracts": { "type": "array", "minItems": 43, "maxItems": 43, "items": { "$ref": "#/$defs/contract" } },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "operatorRoster": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/address" } },
    "attestations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/attestation" } },
    "dossierDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" }, "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "raw": { "type": "object", "additionalProperties": false, "required": ["provider", "url", "host", "httpStatus", "fetchedAt", "responseDigest", "responseBase64"], "properties": {
      "provider": { "enum": ["etherscan-v2-official", "sourcify-v2-independent"] }, "url": { "type": "string", "format": "uri" }, "host": { "enum": ["api.etherscan.io", "sourcify.dev"] },
      "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 }, "fetchedAt": { "type": "string", "format": "date-time" }, "responseDigest": { "$ref": "#/$defs/digest" }, "responseBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$", "maxLength": 11184812 }
    } },
    "chainCode": { "type": "object", "additionalProperties": false, "required": ["fetchedAt", "blockTag", "responseDigest", "responseBase64"], "properties": { "fetchedAt": { "type": "string", "format": "date-time" }, "blockTag": { "const": "finalized" }, "responseDigest": { "$ref": "#/$defs/digest" }, "responseBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" } } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["path", "name", "address", "capsuleArtifactDigest", "buildInfoId", "providers", "chainCode"], "properties": {
      "path": { "type": "string", "minLength": 1 }, "name": { "type": "string", "pattern": "^P42" }, "address": { "$ref": "#/$defs/address" }, "capsuleArtifactDigest": { "$ref": "#/$defs/digest" }, "buildInfoId": { "type": "string", "minLength": 1 },
      "providers": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/raw" }, { "$ref": "#/$defs/raw" }], "items": false }, "chainCode": { "$ref": "#/$defs/chainCode" }
    } },
    "attestation": { "type": "object", "additionalProperties": false, "required": ["operator", "nonce", "signature"], "properties": { "operator": { "$ref": "#/$defs/address" }, "nonce": { "$ref": "#/$defs/bytes32" }, "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" } } }
  }
}
