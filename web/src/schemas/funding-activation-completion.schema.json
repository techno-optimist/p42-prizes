{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/funding-activation-completion.schema.json",
  "title": "P42 finalized funding activation completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "chainId", "network", "planDigest", "manifestBytesDigest", "deploymentCommit", "deploymentConfigHash", "releaseBindingDigest", "authorizationDigest", "authorizationBytesDigest", "authorizationExpiresAt", "rpcAuthority", "finalizedBlockNumber", "finalizedBlockHash", "finalizedBlockTimestamp", "boards", "completionDigest"],
  "properties": {
    "schema": { "const": "p42-funding-activation-completion/v2" },
    "status": { "const": "complete" },
    "chainId": { "enum": [8453, 84532] },
    "network": { "enum": ["base-mainnet", "base-sepolia"] },
    "planDigest": { "$ref": "#/$defs/digest" },
    "manifestBytesDigest": { "$ref": "#/$defs/digest" },
    "deploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "deploymentConfigHash": { "$ref": "#/$defs/bytes32" },
    "releaseBindingDigest": { "$ref": "#/$defs/digest" },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "authorizationBytesDigest": { "$ref": "#/$defs/digest" },
    "authorizationExpiresAt": { "type": "integer", "minimum": 1 },
    "rpcAuthority": { "$ref": "#/$defs/rpcAuthority" },
    "finalizedBlockNumber": { "type": "integer", "minimum": 0 },
    "finalizedBlockHash": { "$ref": "#/$defs/bytes32" },
    "finalizedBlockTimestamp": { "type": "integer", "minimum": 1 },
    "boards": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["problemId", "submissionManager", "pool", "poolRuntimeCodeHash", "authorizedFundingDigest", "fundingAuthorizationDigest", "fundingAuthorizationExpiresAt", "fundingArmed", "acceptingFunds", "armOperation", "openOperation"],
        "properties": {
          "problemId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "submissionManager": { "$ref": "#/$defs/address" },
          "pool": { "$ref": "#/$defs/address" },
          "poolRuntimeCodeHash": { "$ref": "#/$defs/bytes32" },
          "authorizedFundingDigest": { "$ref": "#/$defs/bytes32" },
          "fundingAuthorizationDigest": { "$ref": "#/$defs/bytes32" },
          "fundingAuthorizationExpiresAt": { "type": "integer", "minimum": 1 },
          "fundingArmed": { "const": true },
          "acceptingFunds": { "const": true },
          "armOperation": { "$ref": "#/$defs/executedOperation" },
          "openOperation": { "$ref": "#/$defs/executedOperation" }
        }
      }
    },
    "completionDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "rpcAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "registryDigest", "primary", "secondary"],
      "properties": {
        "schema": { "const": "p42-activation-rpc-authority/v1" },
        "registryDigest": { "$ref": "#/$defs/digest" },
        "primary": { "$ref": "#/$defs/observedRpcProfile" },
        "secondary": { "$ref": "#/$defs/observedRpcProfile" }
      }
    },
    "observedRpcProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["operatorId", "endpointOrigin", "endpointProfileDigest", "observedRawChainId"],
      "properties": {
        "operatorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "endpointOrigin": { "type": "string", "maxLength": 267, "pattern": "^https://(?=[^/:?#]{1,253}(?::[0-9]{1,5})?$)(?!(?:0x[0-9a-f]+|[0-9]+)(?:\\.(?:0x[0-9a-f]+|[0-9]+)){0,3}(?::|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?::(?!443$)(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$" },
        "endpointProfileDigest": { "$ref": "#/$defs/digest" },
        "observedRawChainId": { "type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]*)$" }
      }
    },
    "executedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "state"],
      "properties": {
        "operationId": { "$ref": "#/$defs/bytes32" },
        "state": { "const": 2 }
      }
    }
  }
}
