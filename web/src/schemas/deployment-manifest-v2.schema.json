{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/deployment-manifest-v2.schema.json",
  "title": "P42 Prizes governance-owned multi-board deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "deployedAt",
    "deploymentCommit",
    "deploymentConfigHash",
    "network",
    "governance",
    "roles",
    "parameters",
    "contracts",
    "governanceSetup",
    "setupTransactions",
    "problems",
    "sourceVerification",
    "indexer"
  ],
  "properties": {
    "schema": { "const": "p42-prizes/deployment-manifest/v2" },
    "status": {
      "enum": [
        "example-not-deployed",
        "pending-governance-setup",
        "governance-setup-complete"
      ]
    },
    "deployedAt": { "type": "string", "format": "date-time" },
    "deploymentCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "deploymentConfigHash": { "$ref": "#/$defs/bytes32" },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chainId", "explorerBaseUrl"],
      "properties": {
        "name": { "const": "baseSepolia" },
        "chainId": { "const": 84532 },
        "explorerBaseUrl": { "type": "string", "format": "uri" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownershipModel",
        "timelock",
        "signers",
        "threshold",
        "overrideThreshold",
        "delaySeconds",
        "overrideDelaySeconds",
        "operationGracePeriodSeconds",
        "guardian"
      ],
      "properties": {
        "ownershipModel": { "const": "P42MultisigTimelock" },
        "timelock": { "$ref": "#/$defs/address" },
        "signers": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/address" }
        },
        "threshold": { "$ref": "#/$defs/positiveUintString" },
        "overrideThreshold": { "$ref": "#/$defs/positiveUintString" },
        "delaySeconds": { "$ref": "#/$defs/positiveUintString" },
        "overrideDelaySeconds": { "$ref": "#/$defs/positiveUintString" },
        "operationGracePeriodSeconds": { "$ref": "#/$defs/positiveUintString" },
        "guardian": { "$ref": "#/$defs/address" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployer", "owner", "treasury", "resolver", "guardian"],
      "properties": {
        "deployer": { "$ref": "#/$defs/address" },
        "owner": { "$ref": "#/$defs/address" },
        "treasury": { "$ref": "#/$defs/address" },
        "resolver": { "$ref": "#/$defs/address" },
        "guardian": { "$ref": "#/$defs/address" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alphaBps",
        "betaBps",
        "challengeWindowSeconds",
        "feeBps",
        "minCounterBondWei",
        "minPostingBondWei",
        "rerunCostMultiplierBps",
        "rerunCostWei",
        "resolverDecisionBondWei",
        "resolverFraudWindowSeconds"
      ],
      "properties": {
        "alphaBps": { "$ref": "#/$defs/uintString" },
        "betaBps": { "$ref": "#/$defs/uintString" },
        "challengeWindowSeconds": { "$ref": "#/$defs/positiveUintString" },
        "feeBps": { "$ref": "#/$defs/uintString" },
        "minCounterBondWei": { "$ref": "#/$defs/uintString" },
        "minPostingBondWei": { "$ref": "#/$defs/uintString" },
        "rerunCostMultiplierBps": { "$ref": "#/$defs/uintString" },
        "rerunCostWei": { "$ref": "#/$defs/uintString" },
        "resolverDecisionBondWei": { "$ref": "#/$defs/positiveUintString" },
        "resolverFraudWindowSeconds": { "$ref": "#/$defs/positiveUintString" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timelock", "registry", "rolloverVault"],
      "properties": {
        "timelock": { "$ref": "#/$defs/contract" },
        "registry": { "$ref": "#/$defs/contract" },
        "rolloverVault": { "$ref": "#/$defs/contract" }
      }
    },
    "governanceSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedAt", "completionBlock", "checks"],
      "properties": {
        "status": { "enum": ["pending", "complete"] },
        "completedAt": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "completionBlock": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ok"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "ok": { "const": true }
            }
          }
        }
      }
    },
    "setupTransactions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 110,
      "items": { "$ref": "#/$defs/setupOperation" }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/problem" }
    },
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredExplorer", "contracts"],
      "properties": {
        "status": { "enum": ["pending", "verified"] },
        "requiredExplorer": { "type": "string", "format": "uri" },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timelock", "registry", "rolloverVault", "boards"],
          "properties": {
            "timelock": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] },
            "registry": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] },
            "rolloverVault": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] },
            "boards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": { "$ref": "#/$defs/boardSourceVerification" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": {
            "properties": {
              "contracts": {
                "properties": {
                  "timelock": { "type": "string", "format": "uri" },
                  "registry": { "type": "string", "format": "uri" },
                  "rolloverVault": { "type": "string", "format": "uri" },
                  "boards": {
                    "items": {
                      "properties": {
                        "pool": { "type": "string", "format": "uri" },
                        "ledger": { "type": "string", "format": "uri" },
                        "submissions": { "type": "string", "format": "uri" },
                        "challenges": { "type": "string", "format": "uri" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "indexer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startBlock",
        "finalityPolicy",
        "indexedThroughBlock",
        "reconciliationReport"
      ],
      "properties": {
        "startBlock": { "type": "integer", "minimum": 0 },
        "finalityPolicy": { "$ref": "#/$defs/finalityPolicy" },
        "indexedThroughBlock": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "reconciliationReport": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "governance-setup-complete" } } },
      "then": {
        "properties": {
          "governanceSetup": {
            "properties": {
              "status": { "const": "complete" },
              "completedAt": { "type": "string", "format": "date-time" },
              "completionBlock": { "type": "integer", "minimum": 0 },
              "checks": { "minItems": 1 }
            }
          },
          "setupTransactions": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/setupOperation" },
                {
                  "properties": {
                    "status": { "const": "executed" },
                    "executedOperationId": { "$ref": "#/$defs/bytes32" },
                    "executedOperationClass": { "enum": ["standard", "override"] },
                    "txHash": { "$ref": "#/$defs/transactionHash" },
                    "blockNumber": { "type": "integer", "minimum": 0 }
                  }
                }
              ]
            }
          },
          "problems": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/problem" },
                {
                  "properties": {
                    "registrationStatus": { "const": "registered-and-frozen" },
                    "explicitlyFrozen": { "const": true },
                    "fundingArmed": { "const": false },
                    "acceptingFunds": { "const": false },
                    "registerTxHash": { "$ref": "#/$defs/transactionHash" },
                    "registerBlockNumber": { "type": "integer", "minimum": 0 }
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "governanceSetup": {
            "properties": {
              "status": { "const": "pending" },
              "completedAt": { "type": "null" },
              "completionBlock": { "type": "null" },
              "checks": { "maxItems": 0 }
            }
          },
          "setupTransactions": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/setupOperation" },
                {
                  "properties": {
                    "status": { "const": "pending" },
                    "executedOperationId": { "type": "null" },
                    "executedOperationClass": { "type": "null" },
                    "txHash": { "type": "null" },
                    "blockNumber": { "type": "null" }
                  }
                }
              ]
            }
          },
          "problems": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/problem" },
                {
                  "properties": {
                    "registrationStatus": { "const": "pending" },
                    "explicitlyFrozen": { "const": false },
                    "fundingArmed": { "const": false },
                    "acceptingFunds": { "const": false },
                    "registerTxHash": { "type": "null" },
                    "registerBlockNumber": { "type": "null" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "verifierImageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Canonical bare verifier image digest. verifierImageHash = keccak256(utf8(verifierImageDigest))."
    },
    "verifierImageHashAlgorithm": {
      "const": "keccak256-utf8/v1",
      "description": "Versioned verifier-image anchor relation: verifierImageHash = keccak256(utf8(verifierImageDigest))."
    },
    "admissionMatrixDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Canonical digest of the validated N-host admission matrix. admissionMatrixHash = keccak256(utf8(admissionMatrixDigest))."
    },
    "admissionMatrixHashAlgorithm": {
      "const": "keccak256-utf8/v1",
      "description": "Versioned admission-matrix anchor relation: admissionMatrixHash = keccak256(utf8(admissionMatrixDigest))."
    },
    "durableAdmissionMatrixURI": {
      "type": "string",
      "pattern": "^(?:ipfs|ar):\\/\\/\\S+$"
    },
    "problemSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "verifierVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "verifierSourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Canonical source-tree digest over src/ and problems/<problemSlug>/ with problem.yaml.verifier.image normalized to its source sentinel."
    },
    "verifierSourceDigestAlgorithm": {
      "const": "p42-source-tree-sha256/v2"
    },
    "verifierSourceHashAlgorithm": {
      "const": "keccak256-utf8/v1",
      "description": "Versioned source anchor relation: verifierSourceHash = keccak256(utf8(verifierSourceDigest))."
    },
    "calldata": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})*$" },
    "transactionHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "uintString": { "type": "string", "pattern": "^[0-9]+$" },
    "positiveUintString": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "certifiedObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedBest", "direction", "minImprovement"],
      "properties": {
        "seedBest": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["minimize", "maximize"] },
        "minImprovement": { "type": "string", "minLength": 1 }
      }
    },
    "finalityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "confirmations",
        "logChunkSize",
        "reorgOverlapBlocks",
        "maxRetries",
        "retryBaseDelayMs",
        "maxScanRestarts"
      ],
      "properties": {
        "mode": { "const": "confirmations" },
        "confirmations": { "type": "integer", "minimum": 1 },
        "logChunkSize": { "type": "integer", "minimum": 2 },
        "reorgOverlapBlocks": { "type": "integer", "minimum": 1 },
        "maxRetries": { "type": "integer", "minimum": 1 },
        "retryBaseDelayMs": { "type": "integer", "minimum": 0 },
        "maxScanRestarts": { "type": "integer", "minimum": 1 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "txHash",
        "blockNumber",
        "abiHash",
        "runtimeCodeHash",
        "deployedCodeHash",
        "constructorArgsHash",
        "constructorArgs"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "txHash": { "$ref": "#/$defs/transactionHash" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "abiHash": { "$ref": "#/$defs/bytes32" },
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "deployedCodeHash": { "$ref": "#/$defs/bytes32" },
        "constructorArgsHash": { "$ref": "#/$defs/bytes32" },
        "constructorArgs": { "type": "array" }
      }
    },
    "boardSourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problemId", "pool", "ledger", "submissions", "challenges"],
      "properties": {
        "problemId": { "$ref": "#/$defs/positiveUintString" },
        "pool": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] },
        "ledger": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] },
        "submissions": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] },
        "challenges": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] }
      }
    },
    "transactionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "value", "data"],
      "properties": {
        "to": { "$ref": "#/$defs/address" },
        "value": { "$ref": "#/$defs/uintString" },
        "data": { "$ref": "#/$defs/calldata" }
      }
    },
    "setupOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "label",
        "operationClass",
        "status",
        "target",
        "value",
        "data",
        "salt",
        "operationId",
        "dependsOn",
        "requiredConfirmations",
        "delaySeconds",
        "transactionBuilder",
        "overrideFallback",
        "executedOperationId",
        "executedOperationClass",
        "txHash",
        "blockNumber"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "operationClass": { "enum": ["standard", "override"] },
        "status": { "enum": ["pending", "executed"] },
        "target": { "$ref": "#/$defs/address" },
        "value": { "$ref": "#/$defs/uintString" },
        "data": { "$ref": "#/$defs/calldata" },
        "salt": { "$ref": "#/$defs/bytes32" },
        "operationId": { "$ref": "#/$defs/bytes32" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/bytes32" }
        },
        "requiredConfirmations": { "$ref": "#/$defs/positiveUintString" },
        "delaySeconds": { "$ref": "#/$defs/positiveUintString" },
        "transactionBuilder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schedule", "confirm", "execute"],
          "properties": {
            "schedule": { "$ref": "#/$defs/transactionRequest" },
            "confirm": { "$ref": "#/$defs/transactionRequest" },
            "execute": { "$ref": "#/$defs/transactionRequest" }
          }
        },
        "overrideFallback": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operationId",
                "salt",
                "requiredConfirmations",
                "delaySeconds",
                "transactionBuilder"
              ],
              "properties": {
                "operationId": { "$ref": "#/$defs/bytes32" },
                "salt": { "$ref": "#/$defs/bytes32" },
                "requiredConfirmations": { "$ref": "#/$defs/positiveUintString" },
                "delaySeconds": { "$ref": "#/$defs/positiveUintString" },
                "transactionBuilder": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schedule", "confirm", "execute"],
                  "properties": {
                    "schedule": { "$ref": "#/$defs/transactionRequest" },
                    "confirm": { "$ref": "#/$defs/transactionRequest" },
                    "execute": { "$ref": "#/$defs/transactionRequest" }
                  }
                }
              }
            }
          ]
        },
        "executedOperationId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bytes32" }]
        },
        "executedOperationClass": {
          "oneOf": [{ "type": "null" }, { "enum": ["standard", "override"] }]
        },
        "txHash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transactionHash" }]
        },
        "blockNumber": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problemId",
        "registrationStatus",
        "problemSlug",
        "verifierVersion",
        "metadataURI",
        "specHash",
        "verifierSourceDigest",
        "verifierSourceDigestAlgorithm",
        "verifierSourceHash",
        "verifierSourceHashAlgorithm",
        "verifierImageDigest",
        "verifierImageHashAlgorithm",
        "verifierImageHash",
        "admissionMatrixDigest",
        "admissionMatrixHashAlgorithm",
        "admissionMatrixHash",
        "admissionMatrixURI",
        "immutablePins",
        "minImprovementAtoms",
        "seedScoreAtoms",
        "certifiedObjective",
        "scoreAtomScale",
        "fundingCapWei",
        "onchainDa",
        "maxSolutionBytes",
        "earliestCloseTimestamp",
        "closeByTimestamp",
        "explicitlyFrozen",
        "fundingArmed",
        "acceptingFunds",
        "registerTxHash",
        "registerBlockNumber",
        "contracts",
        "pool",
        "ledger",
        "submissionManager",
        "challengeManager"
      ],
      "properties": {
        "problemId": { "$ref": "#/$defs/positiveUintString" },
        "registrationStatus": { "enum": ["pending", "registered-and-frozen"] },
        "problemSlug": { "$ref": "#/$defs/problemSlug" },
        "verifierVersion": { "$ref": "#/$defs/verifierVersion" },
        "metadataURI": { "type": "string", "minLength": 1 },
        "specHash": { "$ref": "#/$defs/bytes32" },
        "verifierSourceDigest": { "$ref": "#/$defs/verifierSourceDigest" },
        "verifierSourceDigestAlgorithm": { "$ref": "#/$defs/verifierSourceDigestAlgorithm" },
        "verifierSourceHash": { "$ref": "#/$defs/bytes32" },
        "verifierSourceHashAlgorithm": { "$ref": "#/$defs/verifierSourceHashAlgorithm" },
        "verifierImageDigest": { "$ref": "#/$defs/verifierImageDigest" },
        "verifierImageHashAlgorithm": { "$ref": "#/$defs/verifierImageHashAlgorithm" },
        "verifierImageHash": { "$ref": "#/$defs/bytes32" },
        "admissionMatrixDigest": { "$ref": "#/$defs/admissionMatrixDigest" },
        "admissionMatrixHashAlgorithm": { "$ref": "#/$defs/admissionMatrixHashAlgorithm" },
        "admissionMatrixHash": { "$ref": "#/$defs/bytes32" },
        "admissionMatrixURI": { "$ref": "#/$defs/durableAdmissionMatrixURI" },
        "immutablePins": { "const": true },
        "minImprovementAtoms": { "$ref": "#/$defs/positiveUintString" },
        "seedScoreAtoms": { "type": "string", "pattern": "^-?[0-9]+$" },
        "certifiedObjective": { "$ref": "#/$defs/certifiedObjective" },
        "scoreAtomScale": { "const": "1000000000000000000" },
        "fundingCapWei": { "$ref": "#/$defs/positiveUintString" },
        "onchainDa": { "type": "boolean" },
        "maxSolutionBytes": { "$ref": "#/$defs/uintString" },
        "earliestCloseTimestamp": { "$ref": "#/$defs/positiveUintString" },
        "closeByTimestamp": { "$ref": "#/$defs/positiveUintString" },
        "explicitlyFrozen": { "type": "boolean" },
        "fundingArmed": { "type": "boolean" },
        "acceptingFunds": { "type": "boolean" },
        "registerTxHash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transactionHash" }]
        },
        "registerBlockNumber": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pool", "ledger", "submissions", "challenges"],
          "properties": {
            "pool": { "$ref": "#/$defs/contract" },
            "ledger": { "$ref": "#/$defs/contract" },
            "submissions": { "$ref": "#/$defs/contract" },
            "challenges": { "$ref": "#/$defs/contract" }
          }
        },
        "pool": { "$ref": "#/$defs/address" },
        "ledger": { "$ref": "#/$defs/address" },
        "submissionManager": { "$ref": "#/$defs/address" },
        "challengeManager": { "$ref": "#/$defs/address" }
      },
      "allOf": [
        {
          "if": { "properties": { "onchainDa": { "const": true } } },
          "then": { "properties": { "maxSolutionBytes": { "$ref": "#/$defs/positiveUintString" } } },
          "else": { "properties": { "maxSolutionBytes": { "const": "0" } } }
        }
      ]
    }
  }
}
