      "profile": "outer-bn254-v1",
      "event": {"tag": "baseField", "encoding": "koalaBearPacked8", "counter": 1, "logicalLength": 2, "payload": ["4294967297"]},
      "expectedFrameWords": ["1345597953", "1", "16", "2", "1", "0", "0", "0", "2", "0", "0", "0", "1", "0", "0", "0", "4294967297", "1162757121"],
