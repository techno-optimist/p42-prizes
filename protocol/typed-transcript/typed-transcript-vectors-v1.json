  "negativePairs": [
    {
      "id": "packed-trailing-zero",
      "profile": "outer-bn254-v1",
      "left": {"tag": "baseField", "encoding": "koalaBearPacked8", "counter": 1, "logicalLength": 1, "payload": ["7"]},
      "right": {"tag": "baseField", "encoding": "koalaBearPacked8", "counter": 1, "logicalLength": 2, "payload": ["7"]},
      "reason": "The packed payload aliases arithmetically, but logical length changes the frame."
    },
    {
      "id": "direct-trailing-zero",
      "profile": "inner-koalabear-v1",
      "left": {"tag": "baseField", "encoding": "koalaBearDirect", "counter": 3, "logicalLength": 1, "payload": ["5"]},
      "right": {"tag": "baseField", "encoding": "koalaBearDirect", "counter": 3, "logicalLength": 2, "payload": ["5", "0"]},
      "reason": "Occupied rate lanes and frame length are explicit; a stale lane cannot supply the zero."
    },
    {
      "id": "scalar-commitment-type",
      "profile": "outer-bn254-v1",
      "left": {"tag": "baseField", "encoding": "koalaBearPacked8", "counter": 4, "logicalLength": 1, "payload": ["42"]},
      "right": {"tag": "commitment", "encoding": "bn254Native", "counter": 4, "logicalLength": 1, "payload": ["42"]},
      "reason": "Equal numeric payloads in distinct semantic types have distinct tags and encodings."
    },
    {
      "id": "flat-nested-boundary",
      "profile": "inner-koalabear-v1",
      "left": {"tag": "sliceBegin", "encoding": "container", "counter": 5, "logicalLength": 2, "payload": []},
      "right": {"tag": "containerBegin", "encoding": "container", "counter": 5, "logicalLength": 2, "payload": []},
      "reason": "A homogeneous slice and a nested container cannot flatten to the same event."
    },
    {
      "id": "squeeze-kind",
      "profile": "inner-koalabear-v1",
      "left": {"tag": "squeezeField", "encoding": "squeezeRequest", "counter": 6, "logicalLength": 4, "payload": []},
      "right": {"tag": "squeezeBits", "encoding": "squeezeRequest", "counter": 6, "logicalLength": 4, "payload": []},
      "reason": "Four field challenges and four challenge bits are distinct requests."
    }
  ],
  "rejectionVectors": [
    {"id": "missing-version", "envelope": {"protocolId": "p42.sp1.typed-transcript", "profile": "inner-koalabear-v1"}, "error": "missing transcript version"},
    {"id": "legacy-version", "envelope": {"protocolId": "p42.sp1.typed-transcript", "version": 0, "profile": "inner-koalabear-v1"}, "error": "legacy transcript is not TypedTranscriptV1"},
    {"id": "unknown-profile", "envelope": {"protocolId": "p42.sp1.typed-transcript", "version": 1, "profile": "outer-unknown"}, "error": "unknown transcript profile"},
    {"id": "wrong-protocol", "envelope": {"protocolId": "sp1.legacy", "version": 1, "profile": "outer-bn254-v1"}, "error": "protocol identifier mismatch"}
  ]
}
