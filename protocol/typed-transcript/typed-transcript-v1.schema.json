{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.world/protocol/typed-transcript/typed-transcript-v1.schema.json",
  "title": "P42 TypedTranscriptV1 design constants",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactStatus", "remediatesIssue164", "protocolId", "version", "fieldProfiles", "outerChallengeExtraction", "versionEnvelope", "constants", "phases", "eventTags", "encodingTags", "proofModeRouting", "gateway"],
  "properties": {
    "$schema": {"type": "string"},
    "artifactStatus": {"const": "design-only-non-activating"},
    "remediatesIssue164": {"const": false},
    "protocolId": {"const": "p42.sp1.typed-transcript"},
    "version": {"const": 1},
    "fieldProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inner-koalabear-v1", "outer-bn254-rate-koalabear-v1"],
      "properties": {
        "inner-koalabear-v1": {"$ref": "#/$defs/profile"},
        "outer-bn254-rate-koalabear-v1": {"$ref": "#/$defs/profile"}
      }
    },
    "outerChallengeExtraction": {"$ref": "#/$defs/outerChallengeExtraction"},
    "versionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wireLengthBytes", "wireMagicHex", "wireIntegerByteOrder", "fieldWordBytes", "fieldWordByteOrder", "reservedFinalByte"],
      "properties": {
        "wireLengthBytes": {"const": 16},
        "wireMagicHex": {"const": "0x5034325454563100"},
        "wireIntegerByteOrder": {"const": "big-endian"},
        "fieldWordBytes": {"const": 2},
        "fieldWordByteOrder": {"const": "big-endian"},
        "reservedFinalByte": {"const": 0}
      }
    },
    "constants": {"$ref": "#/$defs/uniqueIntegerMap"},
    "phases": {"$ref": "#/$defs/uniqueIntegerMap"},
    "eventTags": {"$ref": "#/$defs/uniqueIntegerMap"},
    "encodingTags": {"$ref": "#/$defs/uniqueIntegerMap"},
    "proofModeRouting": {"$ref": "#/$defs/proofModeRouting"},
    "gateway": {"$ref": "#/$defs/gateway"}
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "fieldId", "permutationId", "modulus", "width", "rate", "capacity", "maxSqueezeBits", "supportsSqueezeExtension", "rateField", "challengeField"],
      "properties": {
        "profileId": {"type": "integer", "minimum": 1, "maximum": 15},
        "fieldId": {"type": "integer", "minimum": 1, "maximum": 255},
        "permutationId": {"type": "integer", "minimum": 1, "maximum": 255},
        "modulus": {"type": "string", "pattern": "^[1-9][0-9]+$"},
        "width": {"type": "integer", "minimum": 2},
        "rate": {"type": "integer", "minimum": 1},
        "capacity": {"type": "integer", "minimum": 1},
        "maxSqueezeBits": {"type": "integer", "minimum": 1},
        "supportsSqueezeExtension": {"type": "boolean"},
        "rateField": {"enum": ["koalabear", "bn254"]},
        "challengeField": {"const": "koalabear"}
      }
    },
    "outerChallengeExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "scalarMethod", "koalaBearModulus", "extensionDegree", "extensionBasis", "bitsMethod", "minChallengeBits", "maxChallengeBits", "nativeBn254Challenges"],
      "properties": {
        "source": {"const": "bn254-rate-word"},
        "scalarMethod": {"const": "bn254-mod-koalabear"},
        "koalaBearModulus": {"const": 2130706433},
        "extensionDegree": {"const": 4},
        "extensionBasis": {"const": "sp1-koalabear-extension4-pinned-by-successor-fork"},
        "bitsMethod": {"const": "low-bits"},
        "minChallengeBits": {"const": 1},
        "maxChallengeBits": {"const": 30},
        "nativeBn254Challenges": {"const": false}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v0Decoder", "v1Decoder", "v1Profile", "gateway"],
      "properties": {
        "v0Decoder": {"type": "string", "pattern": "^legacy-v0-"},
        "v1Decoder": {"type": "string", "minLength": 1},
        "v1Profile": {"enum": ["inner-koalabear-v1", "outer-bn254-rate-koalabear-v1"]},
        "gateway": {"enum": ["none", "validate-bind-strip-forward"]}
      }
    },
    "proofModeRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "compressed", "shrink", "wrap", "groth16", "plonk"],
      "properties": {
        "core": {"$ref": "#/$defs/route"},
        "compressed": {"$ref": "#/$defs/route"},
        "shrink": {"$ref": "#/$defs/route"},
        "wrap": {"$ref": "#/$defs/route"},
        "groth16": {"$ref": "#/$defs/route"},
        "plonk": {"$ref": "#/$defs/route"}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outerEnvelopeBytes", "outerProfile", "wireShape", "forwardedShape", "requiresSuccessorProofEnvelopeBinding", "stripAfterValidationOnly", "silentSdkStrippingAllowed", "legacyVerifierPinning"],
      "properties": {
        "name": {"const": "p42-v1"},
        "outerEnvelopeBytes": {"const": 16},
        "outerProfile": {"const": "outer-bn254-rate-koalabear-v1"},
        "wireShape": {"const": "envelope16-selector-payload"},
        "forwardedShape": {"const": "selector-payload"},
        "requiresSuccessorProofEnvelopeBinding": {"const": true},
        "stripAfterValidationOnly": {"const": true},
        "silentSdkStrippingAllowed": {"const": false},
        "legacyVerifierPinning": {"const": "separate-mode-specific-pin"}
      }
    },
    "uniqueIntegerMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
