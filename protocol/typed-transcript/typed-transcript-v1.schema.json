{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.world/protocol/typed-transcript/typed-transcript-v1.schema.json",
  "title": "P42 TypedTranscriptV1 design constants",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactStatus", "remediatesIssue164", "protocolId", "version", "fieldProfiles", "permutations", "extensionFields", "outerChallengeExtraction", "versionEnvelope", "constants", "phases", "eventTags", "encodingTags", "proofModeRouting", "proofWire", "gateway"],
  "properties": {
    "$schema": {"type": "string"},
    "artifactStatus": {"const": "design-only-non-activating"},
    "remediatesIssue164": {"const": false},
    "protocolId": {"const": "p42.sp1.typed-transcript"},
    "version": {"const": 1},
    "fieldProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inner-koalabear-v1", "outer-bn254-rate-koalabear-v1"],
      "properties": {
        "inner-koalabear-v1": {"$ref": "#/$defs/profile"},
        "outer-bn254-rate-koalabear-v1": {"$ref": "#/$defs/profile"}
      }
    },
    "permutations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer-bn254-poseidon2-width3-v1"],
      "properties": {
        "outer-bn254-poseidon2-width3-v1": {"$ref": "#/$defs/outerPermutation"}
      }
    },
    "extensionFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["koalabear-binomial-degree4-v1"],
      "properties": {
        "koalabear-binomial-degree4-v1": {"$ref": "#/$defs/extensionField"}
      }
    },
    "outerChallengeExtraction": {"$ref": "#/$defs/outerChallengeExtraction"},
    "versionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wireLengthBytes", "wireMagicHex", "wireIntegerByteOrder", "fieldWordBytes", "fieldWordByteOrder", "reservedFinalByte"],
      "properties": {
        "wireLengthBytes": {"const": 16},
        "wireMagicHex": {"const": "0x5034325454563100"},
        "wireIntegerByteOrder": {"const": "big-endian"},
        "fieldWordBytes": {"const": 2},
        "fieldWordByteOrder": {"const": "big-endian"},
        "reservedFinalByte": {"const": 0}
      }
    },
    "constants": {"$ref": "#/$defs/uniqueIntegerMap"},
    "phases": {"$ref": "#/$defs/uniqueIntegerMap"},
    "eventTags": {"$ref": "#/$defs/uniqueIntegerMap"},
    "encodingTags": {"$ref": "#/$defs/uniqueIntegerMap"},
    "proofModeRouting": {"$ref": "#/$defs/proofModeRouting"},
    "proofWire": {"$ref": "#/$defs/proofWire"},
    "gateway": {"$ref": "#/$defs/gateway"}
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "fieldId", "permutationId", "modulus", "width", "rate", "capacity", "maxSqueezeBits", "supportsSqueezeExtension", "rateField", "challengeField"],
      "properties": {
        "profileId": {"type": "integer", "minimum": 1, "maximum": 15},
        "fieldId": {"type": "integer", "minimum": 1, "maximum": 255},
        "permutationId": {"type": "integer", "minimum": 1, "maximum": 255},
        "permutation": {"const": "outer-bn254-poseidon2-width3-v1"},
        "modulus": {"type": "string", "pattern": "^[1-9][0-9]+$"},
        "width": {"type": "integer", "minimum": 2},
        "rate": {"type": "integer", "minimum": 1},
        "capacity": {"type": "integer", "minimum": 1},
        "maxSqueezeBits": {"type": "integer", "minimum": 1},
        "supportsSqueezeExtension": {"type": "boolean"},
        "rateField": {"enum": ["koalabear", "bn254"]},
        "challengeField": {"const": "koalabear"}
      }
    },
    "outerChallengeExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "scalarMethod", "koalaBearModulus", "extensionDegree", "extensionField", "extensionBasis", "extensionCoefficientOrder", "bitsMethod", "minChallengeBits", "maxChallengeBits", "nativeBn254Challenges"],
      "properties": {
        "source": {"const": "bn254-rate-word"},
        "scalarMethod": {"const": "bn254-mod-koalabear"},
        "koalaBearModulus": {"const": 2130706433},
        "extensionDegree": {"const": 4},
        "extensionField": {"const": "koalabear-binomial-degree4-v1"},
        "extensionBasis": {"const": "1,x,x^2,x^3-mod-x^4-minus-3"},
        "extensionCoefficientOrder": {"const": "c0-c1-c2-c3"},
        "bitsMethod": {"const": "low-bits"},
        "minChallengeBits": {"const": 1},
        "maxChallengeBits": {"const": 30},
        "nativeBn254Challenges": {"const": false}
      }
    },
    "outerPermutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldModulus", "width", "rate", "capacity", "sBoxExponent", "externalRounds", "internalRounds", "roundSchedule", "externalMatrix", "internalMatrix", "roundConstants", "upstreamSource"],
      "properties": {
        "fieldModulus": {"const": "21888242871839275222246405745257275088548364400416034343698204186575808495617"},
        "width": {"const": 3},
        "rate": {"const": 2},
        "capacity": {"const": 1},
        "sBoxExponent": {"const": 5},
        "externalRounds": {"const": 8},
        "internalRounds": {"const": 56},
        "roundSchedule": {"const": "external-4-then-internal-56-then-external-4"},
        "externalMatrix": {"$ref": "#/$defs/matrix3"},
        "internalMatrix": {"$ref": "#/$defs/matrix3"},
        "roundConstants": {"$ref": "#/$defs/roundConstants"},
        "upstreamSource": {"$ref": "#/$defs/poseidonSource"}
      }
    },
    "matrix3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
      }
    },
    "roundConstants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTableRows", "sourceTableElements", "sourceTableEncoding", "sourceTableSha256", "effectiveElements", "effectiveEncoding", "effectiveSha256"],
      "properties": {
        "sourceTableRows": {"const": 64},
        "sourceTableElements": {"const": 192},
        "sourceTableEncoding": {"const": "row-major-64-rows-by-3-lanes-each-lane-canonical-32-byte-big-endian"},
        "sourceTableSha256": {"$ref": "#/$defs/sha256"},
        "effectiveElements": {"const": 80},
        "effectiveEncoding": {"const": "round-order-first-4-external-all-3-lanes-then-56-internal-lane-0-only-then-last-4-external-all-3-lanes-each-lane-canonical-32-byte-big-endian"},
        "effectiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "poseidonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path", "fileSha256", "licenseExpression"],
      "properties": {
        "repository": {"const": "https://github.com/HorizenLabs/poseidon2"},
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "path": {"const": "plain_implementations/src/poseidon2/poseidon2_instance_bn256.rs"},
        "fileSha256": {"$ref": "#/$defs/sha256"},
        "licenseExpression": {"const": "MIT OR Apache-2.0"}
      }
    },
    "extensionField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustType", "baseFieldModulus", "degree", "definingPolynomial", "nonresidue", "coefficientOrder", "laneOrder", "canonicalElement", "canonicalCoefficientEncoding", "upstreamSource"],
      "properties": {
        "rustType": {"const": "BinomialExtensionField<KoalaBear,4>"},
        "baseFieldModulus": {"const": "2130706433"},
        "degree": {"const": 4},
        "definingPolynomial": {"const": "x^4-3"},
        "nonresidue": {"const": "3"},
        "coefficientOrder": {"const": "c0-c1-c2-c3"},
        "laneOrder": {"const": "element-major-then-coefficients-c0-c1-c2-c3"},
        "canonicalElement": {"const": "c0+c1*x+c2*x^2+c3*x^3"},
        "canonicalCoefficientEncoding": {"const": "each-ci-is-the-unique-decimal-integer-in-[0,2130706433)-no-modular-reduction"},
        "upstreamSource": {"$ref": "#/$defs/extensionSource"}
      }
    },
    "extensionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "paths", "licenseExpression"],
      "properties": {
        "repository": {"const": "https://github.com/Plonky3/Plonky3"},
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "paths": {
          "const": ["koala-bear/src/extension.rs", "field/src/extension/binomial_extension.rs"]
        },
        "licenseExpression": {"const": "MIT OR Apache-2.0"}
      }
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v0Decoder", "v1Decoder", "v1Profile", "gateway"],
      "properties": {
        "v0Decoder": {"type": "string", "pattern": "^legacy-v0-"},
        "v1Decoder": {"type": "string", "minLength": 1},
        "v1Profile": {"enum": ["inner-koalabear-v1", "outer-bn254-rate-koalabear-v1"]},
        "gateway": {"enum": ["none", "validate-select-check-strip-call"]}
      }
    },
    "proofModeRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "compressed", "shrink", "wrap", "groth16", "plonk"],
      "properties": {
        "core": {"$ref": "#/$defs/route"},
        "compressed": {"$ref": "#/$defs/route"},
        "shrink": {"$ref": "#/$defs/route"},
        "wrap": {"$ref": "#/$defs/route"},
        "groth16": {"$ref": "#/$defs/route"},
        "plonk": {"$ref": "#/$defs/route"}
      }
    },
    "proofWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "appliesToGateway", "legacyShape", "v1Shape", "selectorBytes", "modeBytes", "payloadLengthBytes", "payloadLengthByteOrder", "modeTags", "structuralTestSelectors"],
      "properties": {
        "scope": {"const": "decoder-only-synthetic-grammar"},
        "appliesToGateway": {"const": false},
        "legacyShape": {"const": "selector4-mode1-length2-payload"},
        "v1Shape": {"const": "envelope16-selector4-mode1-length2-payload"},
        "selectorBytes": {"const": 4},
        "modeBytes": {"const": 1},
        "payloadLengthBytes": {"const": 2},
        "payloadLengthByteOrder": {"const": "big-endian"},
        "modeTags": {"$ref": "#/$defs/modeTags"},
        "structuralTestSelectors": {"$ref": "#/$defs/testSelectors"}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outerEnvelopeBytes", "selectorBytes", "outerProfile", "wireShape", "forwardedShape", "payloadSemantics", "trustedConfigSource", "preVerificationEnvelopeBindingCheck", "bindingSource", "stripAfterValidationOnly", "silentSdkStrippingAllowed", "legacyVerifierPinning", "structuralTestPins"],
      "properties": {
        "name": {"const": "p42-v1"},
        "outerEnvelopeBytes": {"const": 16},
        "selectorBytes": {"const": 4},
        "outerProfile": {"const": "outer-bn254-rate-koalabear-v1"},
        "wireShape": {"const": "envelope16-selector4-opaque-payload"},
        "forwardedShape": {"const": "selector4-opaque-payload"},
        "payloadSemantics": {"const": "opaque"},
        "trustedConfigSource": {"const": "authenticated-deployment-config-only"},
        "preVerificationEnvelopeBindingCheck": {"const": false},
        "bindingSource": {"const": "pinned-successor-circuit-vk-or-authenticated-public-input"},
        "stripAfterValidationOnly": {"const": true},
        "silentSdkStrippingAllowed": {"const": false},
        "legacyVerifierPinning": {"const": "separate-mode-specific-pin"},
        "structuralTestPins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["groth16", "plonk"],
          "properties": {
            "groth16": {"$ref": "#/$defs/verifierPin"},
            "plonk": {"$ref": "#/$defs/verifierPin"}
          }
        }
      }
    },
    "modeTags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "compressed", "shrink", "wrap"],
      "properties": {
        "core": {"const": 1}, "compressed": {"const": 2}, "shrink": {"const": 3},
        "wrap": {"const": 4}
      }
    },
    "testSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "compressed", "shrink", "wrap"],
      "properties": {
        "core": {"const": "0x01000001"}, "compressed": {"const": "0x02000002"},
        "shrink": {"const": "0x03000003"}, "wrap": {"const": "0x04000004"}
      }
    },
    "verifierPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selectorHex", "verifierAddress", "verifierCodehash", "vkId", "circuitId"],
      "properties": {
        "mode": {"enum": ["groth16", "plonk"]},
        "selectorHex": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
        "verifierAddress": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
        "verifierCodehash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
        "vkId": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
        "circuitId": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "uniqueIntegerMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
