{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.world/protocol/typed-transcript/typed-transcript-vectors-v1.schema.json",
  "title": "TypedTranscriptV1 ordered structural vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactStatus", "cryptographicOutputsIncluded", "protocolId", "version", "idRegistry", "positiveTranscripts", "collisionNegativeTranscripts", "rejectionVectors", "outerChallengeExtractionVectors", "proofDecodingVectors", "gatewayVectors", "independentStateTransitionRegressions", "hostileCorpusMutations"],
  "properties": {
    "$schema": {"type": "string"},
    "artifactStatus": {"const": "design-only-non-activating"},
    "cryptographicOutputsIncluded": {"const": false},
    "protocolId": {"const": "p42.sp1.typed-transcript"},
    "version": {"const": 1},
    "idRegistry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "positiveTranscripts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transcript"}},
    "collisionNegativeTranscripts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/collisionPair"}},
    "rejectionVectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rejection"}},
    "outerChallengeExtractionVectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outerExtraction"}},
    "proofDecodingVectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proofDecoding"}},
    "gatewayVectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gatewayVector"}},
    "independentStateTransitionRegressions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateRegression"}},
    "hostileCorpusMutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hostileMutation"}}
  },
  "$defs": {
    "word": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "profile": {"enum": ["inner-koalabear-v1", "outer-bn254-rate-koalabear-v1"]},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "encoding", "counter", "logicalLength", "payload"],
      "properties": {
        "tag": {"type": "string"},
        "encoding": {"type": "string"},
        "counter": {"type": "integer", "minimum": 0},
        "logicalLength": {"type": "integer", "minimum": 0},
        "payload": {"type": "array", "items": {"$ref": "#/$defs/word"}}
      }
    },
    "stackFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "declaredChildren", "observedChildren"],
      "properties": {
        "kind": {"enum": ["slice", "container"]},
        "declaredChildren": {"type": "integer", "minimum": 0},
        "observedChildren": {"type": "integer", "minimum": 0}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "nextCounter", "collectionStack", "permutationStateStatus", "permutationState"],
      "properties": {
        "mode": {"enum": ["uninitialized", "absorbing"]},
        "nextCounter": {"type": "integer", "minimum": 0},
        "collectionStack": {"type": "array", "items": {"$ref": "#/$defs/stackFrame"}},
        "permutationStateStatus": {"enum": ["exact", "not-generated"]},
        "permutationState": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"$ref": "#/$defs/word"}}
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "occupied", "final", "control", "rateWords"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 65535},
        "occupied": {"type": "integer", "minimum": 0},
        "final": {"type": "boolean"},
        "control": {"$ref": "#/$defs/word"},
        "rateWords": {"type": "array", "items": {"$ref": "#/$defs/word"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "transitionKind", "expectedBefore", "expectedFrameWords", "expectedAbsorbBlocks", "expectedSqueezeContinuations", "expectedAfter"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "transitionKind": {"enum": ["absorb", "squeeze"]},
        "expectedBefore": {"$ref": "#/$defs/snapshot"},
        "expectedFrameWords": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/word"}},
        "expectedAbsorbBlocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
        "expectedSqueezeContinuations": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "expectedAfter": {"$ref": "#/$defs/snapshot"}
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "envelopeHex", "expectedInitial", "events", "expectedSteps", "expectedFinal"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "profile": {"$ref": "#/$defs/profile"},
        "envelopeHex": {"type": "string", "pattern": "^0x[0-9a-f]{32}$"},
        "expectedInitial": {"$ref": "#/$defs/snapshot"},
        "events": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/event"}},
        "expectedSteps": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/step"}},
        "expectedFinal": {"$ref": "#/$defs/snapshot"}
      }
    },
    "collisionPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "left", "right", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "profile": {"$ref": "#/$defs/profile"},
        "left": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/event"}},
        "right": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/event"}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "profile", "envelopeHex", "events", "expectedErrorCode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["envelope", "transcript"]},
        "profile": {"$ref": "#/$defs/profile"},
        "envelopeHex": {"type": ["string", "null"]},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "expectedErrorCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "outerExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "rateWords", "bits", "expectedValues", "expectedConsumedRateWords", "expectedErrorCode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["scalar", "extension", "bits"]},
        "rateWords": {"type": "array", "items": {"$ref": "#/$defs/word"}},
        "bits": {"type": ["integer", "null"], "minimum": 0},
        "expectedValues": {"type": "array", "items": {"$ref": "#/$defs/word"}},
        "expectedConsumedRateWords": {"type": ["integer", "null"], "minimum": 0},
        "expectedErrorCode": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "proofDecoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case", "proofMode", "decoderVersion", "wireHex", "fallbackAllowed", "expectedOutcome", "expectedErrorCode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "case": {"enum": ["v0-valid", "v1-valid", "v0-to-v1", "v1-to-v0", "v0-malformed", "v1-malformed", "v0-trailing-byte", "v1-trailing-byte", "v1-wrong-magic", "v1-wrong-version", "v0-wrong-mode", "v1-wrong-mode", "v0-wrong-length", "v1-wrong-length", "v1-downgrade-fallback-forbidden", "v1-wrong-version-fallback-forbidden"]},
        "proofMode": {"enum": ["core", "compressed", "shrink", "wrap", "groth16", "plonk"]},
        "decoderVersion": {"enum": ["v0", "v1"]},
        "wireHex": {"type": "string", "pattern": "^0x(?:[0-9a-f]{2})*$"},
        "fallbackAllowed": {"const": false},
        "expectedOutcome": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/decodeOutcome"}]
        },
        "expectedErrorCode": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "gatewayVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case", "trustedEntryPointMode", "wireHex", "routingSource", "trustedDeploymentConfig", "expectedOutcome", "expectedErrorCode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "case": {"enum": ["valid-groth16", "valid-plonk", "envelope-missing", "profile-substitution", "parameter-substitution", "wrong-proof-mode", "wrong-proof-selector", "cross-mode-verifier", "proof-selected-routing", "wrong-payload-mode", "wrong-configured-selector", "wrong-address", "wrong-codehash", "wrong-vk", "wrong-circuit"]},
        "trustedEntryPointMode": {"enum": ["core", "compressed", "shrink", "wrap", "groth16", "plonk"]},
        "wireHex": {"type": "string", "pattern": "^0x(?:[0-9a-f]{2})*$"},
        "routingSource": {"enum": ["trusted-deployment-config", "proof-bytes"]},
        "trustedDeploymentConfig": {"$ref": "#/$defs/verifierPin"},
        "expectedOutcome": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/gatewayOutcome"}]
        },
        "expectedErrorCode": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "decodeOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoder", "version", "mode", "selectorHex", "payloadHex"],
      "properties": {
        "decoder": {"type": "string", "minLength": 1},
        "version": {"enum": ["v0", "v1"]},
        "mode": {"enum": ["core", "compressed", "shrink", "wrap", "groth16", "plonk"]},
        "selectorHex": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
        "payloadHex": {"type": "string", "pattern": "^0x(?:[0-9a-f]{2})*$"}
      }
    },
    "legacyDecodeOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selectorHex", "payloadHex"],
      "properties": {
        "mode": {"enum": ["groth16", "plonk"]},
        "selectorHex": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
        "payloadHex": {"type": "string", "pattern": "^0x(?:[0-9a-f]{2})*$"}
      }
    },
    "verifierPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selectorHex", "verifierAddress", "verifierCodehash", "vkId", "circuitId"],
      "properties": {
        "mode": {"enum": ["groth16", "plonk"]},
        "selectorHex": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
        "verifierAddress": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
        "verifierCodehash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
        "vkId": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
        "circuitId": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "gatewayOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forwardedHex", "verifierIdentity", "verifierDecode"],
      "properties": {
        "forwardedHex": {"type": "string", "pattern": "^0x(?:[0-9a-f]{2})+$"},
        "verifierIdentity": {"$ref": "#/$defs/verifierPin"},
        "verifierDecode": {"$ref": "#/$defs/legacyDecodeOutcome"}
      }
    },
    "stateRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "before", "event", "expectedErrorCode", "expectedSqueezeContinuations", "expectedAfter"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "profile": {"$ref": "#/$defs/profile"},
        "before": {"$ref": "#/$defs/snapshot"},
        "event": {"$ref": "#/$defs/event"},
        "expectedErrorCode": {
          "oneOf": [
            {"const": "SQUEEZE_IN_CONTAINER"},
            {"type": "null"}
          ]
        },
        "expectedSqueezeContinuations": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "expectedAfter": {"$ref": "#/$defs/snapshot"}
      }
    },
    "hostileMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceCategory", "sourceIndex", "targetCategory", "targetIndex", "expectedErrorCode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "sourceCategory": {"enum": ["positive", "collision-negative", "rejection"]},
        "sourceIndex": {"type": "integer", "minimum": 0},
        "targetCategory": {"enum": ["positive", "collision-negative", "rejection"]},
        "targetIndex": {"type": "integer", "minimum": 0},
        "expectedErrorCode": {"const": "DUPLICATE_VECTOR_ID"}
      }
    }
  }
}
