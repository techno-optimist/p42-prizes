{
  "name": "p42-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous P42 solver/operator agent client (Phase 1 plumbing). Drives the full on-chain lifecycle — self-verify, commit, reveal, finalize, claim — unattended against a deployed P42 manifest.",
  "files": [
    "README.md",
    "challenge-envelope.mjs",
    "canonical-topology.mjs",
    "canonical-topology-v1.json",
    "schemas/",
    "checkpoint-attest.mjs",
    "da-arweave.mjs",
    "da-local.mjs",
    "indexer.mjs",
    "funding-activation.mjs",
    "funding-activation-executor.mjs",
    "funding-activation-run.mjs",
    "lib.mjs",
    "operator.mjs",
    "open-witness-authority-core.mjs",
    "open-witness-promote.mjs",
    "production-validation-context.mjs",
    "role-acceptance.mjs",
    "resolver.mjs",
    "runner-transcript.mjs",
    "runtime_bridge.py",
    "secure_path_bridge.py",
    "signed-transaction.mjs",
    "solver-manifest.mjs",
    "solver.mjs",
    "strict-json.mjs",
    "transcript-arweave.mjs",
    "transcript-store.mjs"
  ],
  "bin": {
    "p42-solve": "solver.mjs",
    "p42-resolve": "resolver.mjs",
    "p42-open-witness-collect": "open-witness-promote.mjs",
    "p42-funding-activation-plan": "funding-activation.mjs",
    "p42-funding-activate": "funding-activation-run.mjs",
    "p42-indexer-checkpoint-attest": "checkpoint-attest.mjs"
  },
  "scripts": {
    "sync:schemas": "node scripts/sync-package-schemas.mjs",
    "prepack": "npm run sync:schemas",
    "test": "node --test *.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "arweave": "^1.15.7",
    "ethers": "^6.17.0",
    "multiformats": "^13.4.2"
  }
}
