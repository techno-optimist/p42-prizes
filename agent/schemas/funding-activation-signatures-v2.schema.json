{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/funding-activation-signatures-v2.schema.json",
  "title": "P42 Funding Activation Signature Bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "chainId", "boardSetDigest", "releaseBindingDigest", "authorizationDigest", "expiresAt", "authorities", "boards"],
  "properties": {
    "schema": { "const": "p42-funding-activation-signatures/v2" },
    "chainId": { "type": "integer", "minimum": 1 },
    "boardSetDigest": { "$ref": "#/$defs/digest" },
    "releaseBindingDigest": { "$ref": "#/$defs/digest" },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "expiresAt": { "$ref": "#/$defs/uint" },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionLaunchAuthority", "independentSecurityAuthority", "governanceAuthority"],
      "properties": {
        "productionLaunchAuthority": { "$ref": "#/$defs/address" },
        "independentSecurityAuthority": { "$ref": "#/$defs/address" },
        "governanceAuthority": { "$ref": "#/$defs/address" }
      }
    },
    "boards": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boardIndex", "problemId", "submissionManager", "nonce", "signatures"],
        "properties": {
          "boardIndex": { "type": "integer", "minimum": 0, "maximum": 9 },
          "problemId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "pattern": "^[1-9][0-9]*$" }] },
          "submissionManager": { "$ref": "#/$defs/address" },
          "nonce": { "$ref": "#/$defs/uint" },
          "signatures": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              { "$ref": "#/$defs/productionSignature" },
              { "$ref": "#/$defs/securitySignature" },
              { "$ref": "#/$defs/governanceSignature" }
            ],
            "items": false
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "uint": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" },
    "signatureRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "signer", "signature"],
      "properties": {
        "role": { "type": "string" },
        "signer": { "$ref": "#/$defs/address" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "productionSignature": {
      "allOf": [{ "$ref": "#/$defs/signatureRecord" }, { "type": "object", "properties": { "role": { "const": "production-launch-authority" } } }]
    },
    "securitySignature": {
      "allOf": [{ "$ref": "#/$defs/signatureRecord" }, { "type": "object", "properties": { "role": { "const": "independent-security-authority" } } }]
    },
    "governanceSignature": {
      "allOf": [{ "$ref": "#/$defs/signatureRecord" }, { "type": "object", "properties": { "role": { "const": "governance-authority" } } }]
    }
  }
}
