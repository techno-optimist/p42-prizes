{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/activation-rpc-operator-registry.schema.json",
  "title": "P42 activation RPC operator registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profiles"],
  "properties": {
    "schema": { "const": "p42-activation-rpc-operator-registry/v1" },
    "profiles": {
      "type": "array", "minItems": 2, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operatorId", "endpointOrigin", "endpointProfileDigest"],
        "properties": {
          "operatorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "endpointOrigin": { "type": "string", "maxLength": 267, "pattern": "^https://(?=[^/:?#]{1,253}(?::[0-9]{1,5})?$)(?!(?:0x[0-9a-f]+|[0-9]+)(?:\\.(?:0x[0-9a-f]+|[0-9]+)){0,3}(?::|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?::(?!443$)(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$" },
          "endpointProfileDigest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
