{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectforty2.ai/prizes/schemas/indexer-checkpoint-v4.schema.json",
  "title": "P42 Prizes deterministic multi-board indexer checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestBinding", "finalityPolicy", "range", "activationEvidence", "boards", "reconstruction"],
  "properties": {
    "schema": { "const": "p42-prizes/indexer-checkpoint/v4" },
    "manifestBinding": { "$ref": "#/$defs/manifestBinding" },
    "finalityPolicy": { "$ref": "#/$defs/finalityPolicy" },
    "range": { "$ref": "#/$defs/range" },
    "activationEvidence": { "$ref": "#/$defs/activationEvidence" },
    "boards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/board" }
    },
    "reconstruction": { "$ref": "#/$defs/reconstruction" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "activationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "planDigest", "finalizedBlockNumber", "finalizedBlockHash", "completionAnchor", "rpcAuthority", "operations"],
      "properties": {
        "schema": { "const": "p42-funding-activation-checkpoint/v1" },
        "planDigest": { "$ref": "#/$defs/sha256Digest" },
        "finalizedBlockNumber": { "type": "integer", "minimum": 0 },
        "finalizedBlockHash": { "$ref": "#/$defs/bytes32" },
        "rpcAuthority": { "$ref": "#/$defs/rpcAuthority" },
        "completionAnchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completionDigest", "blockNumber", "blockHash", "blockTimestamp"],
          "properties": {
            "completionDigest": { "$ref": "#/$defs/sha256Digest" },
            "blockNumber": { "type": "integer", "minimum": 0 },
            "blockHash": { "$ref": "#/$defs/bytes32" },
            "blockTimestamp": { "type": "integer", "minimum": 0 }
          }
        },
        "operations": {
          "type": "array", "minItems": 20, "maxItems": 20, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sequence", "label", "problemId", "operationId", "state"],
            "properties": {
              "sequence": { "type": "integer", "minimum": 11 },
              "label": { "type": "string", "pattern": "^board\\.[1-9][0-9]*\\.(armFunding|setAcceptingFunds)$" },
              "problemId": { "$ref": "#/$defs/positiveUintString" },
              "operationId": { "$ref": "#/$defs/bytes32" },
              "state": { "const": 2 }
            }
          }
        }
      }
    },
    "rpcAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "registryDigest", "primary", "secondary"],
      "properties": {
        "schema": { "const": "p42-activation-rpc-authority/v1" },
        "registryDigest": { "$ref": "#/$defs/sha256Digest" },
        "primary": { "$ref": "#/$defs/observedRpcProfile" },
        "secondary": { "$ref": "#/$defs/observedRpcProfile" }
      }
    },
    "observedRpcProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["operatorId", "endpointOrigin", "endpointProfileDigest", "observedRawChainId"],
      "properties": {
        "operatorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "endpointOrigin": { "type": "string", "maxLength": 267, "pattern": "^https://(?=[^/:?#]{1,253}(?::[0-9]{1,5})?$)(?!(?:0x[0-9a-f]+|[0-9]+)(?:\\.(?:0x[0-9a-f]+|[0-9]+)){0,3}(?::|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?::(?!443$)(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$" },
        "endpointProfileDigest": { "$ref": "#/$defs/sha256Digest" },
        "observedRawChainId": { "type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]*)$" }
      }
    },
    "integerString": { "type": "string", "pattern": "^-?[0-9]+$" },
    "canonicalIntegerString": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
    "canonicalUintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveUintString": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "problemSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "logIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "eventName", "contractAddress", "blockNumber", "blockHash", "transactionHash", "transactionIndex", "logIndex", "blockTimestamp"],
      "properties": {
        "source": { "enum": ["pool", "ledger", "submissions", "challenges", "resolverQuorum", "registry", "rolloverVault"] },
        "eventName": { "type": "string", "minLength": 1 },
        "contractAddress": { "$ref": "#/$defs/address" },
        "blockNumber": { "type": "integer", "minimum": 0 }, "blockHash": { "$ref": "#/$defs/bytes32" },
        "transactionHash": { "$ref": "#/$defs/bytes32" }, "transactionIndex": { "type": "integer", "minimum": 0 },
        "logIndex": { "type": "integer", "minimum": 0 },
        "blockTimestamp": { "$ref": "#/$defs/canonicalUintString" }
      }
    },
    "provenanceLog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "eventName", "contractAddress", "blockNumber", "blockHash", "transactionHash", "transactionIndex", "logIndex", "blockTimestamp", "submissionId", "args", "argsDigest"],
      "properties": {
        "source": { "enum": ["pool", "ledger", "submissions", "challenges", "resolverQuorum", "registry", "rolloverVault"] },
        "eventName": { "type": "string", "minLength": 1 },
        "contractAddress": { "$ref": "#/$defs/address" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "blockHash": { "$ref": "#/$defs/bytes32" },
        "transactionHash": { "$ref": "#/$defs/bytes32" },
        "transactionIndex": { "type": "integer", "minimum": 0 },
        "logIndex": { "type": "integer", "minimum": 0 },
        "blockTimestamp": { "$ref": "#/$defs/canonicalUintString" },
        "submissionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/positiveUintString" }] },
        "args": { "type": "object" },
        "argsDigest": { "$ref": "#/$defs/bytes32" }
      }
    },
    "portalSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionId", "solver", "status", "claimedScoreAtoms", "improvementAtoms", "creditAtoms", "originalCreditAtoms", "solutionCid", "committedAt", "revealedAt", "challengeEndsAt", "finalizedAt", "activeChallenge", "sourceLogs"],
      "properties": {
        "submissionId": { "$ref": "#/$defs/positiveUintString" },
        "solver": { "$ref": "#/$defs/address" },
        "status": { "enum": ["Committed", "Revealed", "Challenged", "Finalized", "Rejected", "Voided"] },
        "claimedScoreAtoms": { "$ref": "#/$defs/canonicalIntegerString" },
        "improvementAtoms": { "$ref": "#/$defs/canonicalUintString" },
        "creditAtoms": { "$ref": "#/$defs/canonicalUintString" },
        "originalCreditAtoms": { "$ref": "#/$defs/canonicalUintString" },
        "solutionCid": { "type": "string" },
        "committedAt": { "$ref": "#/$defs/canonicalUintString" },
        "revealedAt": { "$ref": "#/$defs/canonicalUintString" },
        "challengeEndsAt": { "$ref": "#/$defs/canonicalUintString" },
        "finalizedAt": { "$ref": "#/$defs/canonicalUintString" },
        "activeChallenge": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["challenger", "reasonHash", "challengeBondWei", "challengedAt", "disputeEndsAt", "resolved", "decisionPending", "challengerWins", "transcriptHash", "transcriptURI", "verdictHash"],
              "properties": {
                "challenger": { "$ref": "#/$defs/address" },
                "reasonHash": { "$ref": "#/$defs/bytes32" },
                "challengeBondWei": { "$ref": "#/$defs/canonicalUintString" },
                "challengedAt": { "$ref": "#/$defs/canonicalUintString" },
                "disputeEndsAt": { "$ref": "#/$defs/canonicalUintString" },
                "resolved": { "type": "boolean" },
                "decisionPending": { "type": "boolean" },
                "challengerWins": { "type": "boolean" },
                "transcriptHash": { "$ref": "#/$defs/bytes32" },
                "transcriptURI": { "type": "string" },
                "verdictHash": { "$ref": "#/$defs/bytes32" }
              }
            }
          ]
        },
        "sourceLogs": { "type": "array", "items": { "$ref": "#/$defs/logIdentity" } }
      }
    },
    "portalSolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solver", "creditAtoms", "claimedWei", "finalEntitlementWei", "submissionBondWei", "challengeBondWei", "withdrawableBondWei"],
      "properties": {
        "solver": { "$ref": "#/$defs/address" },
        "creditAtoms": { "$ref": "#/$defs/canonicalUintString" },
        "claimedWei": { "$ref": "#/$defs/canonicalUintString" },
        "finalEntitlementWei": { "$ref": "#/$defs/canonicalUintString" },
        "submissionBondWei": { "$ref": "#/$defs/canonicalUintString" },
        "challengeBondWei": { "$ref": "#/$defs/canonicalUintString" },
        "withdrawableBondWei": { "$ref": "#/$defs/canonicalUintString" }
      }
    },
    "portalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "replayConfig", "frontier", "submissions", "solvers", "pool", "funding", "ledgerClose", "eventProvenance"],
      "properties": {
        "schema": { "const": "p42-prizes/portal-projection/v2" },
        "replayConfig": {
          "type": "object", "additionalProperties": false,
          "required": ["seedScoreAtoms", "minImprovementAtoms", "challengeWindowSeconds", "treasury", "challengeManager", "problemCount"],
          "properties": {
            "seedScoreAtoms": { "$ref": "#/$defs/canonicalIntegerString" },
            "minImprovementAtoms": { "$ref": "#/$defs/positiveUintString" },
            "challengeWindowSeconds": { "$ref": "#/$defs/positiveUintString" },
            "treasury": { "$ref": "#/$defs/address" },
            "challengeManager": { "$ref": "#/$defs/address" },
            "problemCount": { "type": "integer", "minimum": 1, "maximum": 10 },
            "fundingCapWei": { "$ref": "#/$defs/canonicalUintString" },
            "earliestCloseTimestamp": { "$ref": "#/$defs/canonicalUintString" },
            "closeByTimestamp": { "$ref": "#/$defs/canonicalUintString" }
          }
        },
        "frontier": {
          "type": "object", "additionalProperties": false, "required": ["currentAtoms"],
          "properties": { "currentAtoms": { "$ref": "#/$defs/canonicalIntegerString" } }
        },
        "submissions": { "type": "array", "items": { "$ref": "#/$defs/portalSubmission" } },
        "solvers": { "type": "array", "items": { "$ref": "#/$defs/portalSolver" } },
        "pool": {
          "type": "object", "additionalProperties": false,
          "required": ["totalFundedWei", "accountedBalanceWei", "totalClaimedWei", "totalWinningsDonatedWei", "refundableWei", "totalSponsorRefundedWei", "totalFeeAccruedWei", "totalFeePaidWei", "totalResidualPaidWei", "sponsors", "sponsorshipFundings", "winningsDonations"],
          "properties": {
            "totalFundedWei": { "$ref": "#/$defs/canonicalUintString" },
            "accountedBalanceWei": { "$ref": "#/$defs/canonicalUintString" },
            "totalClaimedWei": { "$ref": "#/$defs/canonicalUintString" },
            "totalWinningsDonatedWei": { "$ref": "#/$defs/canonicalUintString" },
            "refundableWei": { "$ref": "#/$defs/canonicalUintString" },
            "totalSponsorRefundedWei": { "$ref": "#/$defs/canonicalUintString" },
            "totalFeeAccruedWei": { "$ref": "#/$defs/canonicalUintString" },
            "totalFeePaidWei": { "$ref": "#/$defs/canonicalUintString" },
            "totalResidualPaidWei": { "$ref": "#/$defs/canonicalUintString" },
            "sponsors": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["sponsor", "principalWei"],
                "properties": { "sponsor": { "$ref": "#/$defs/address" }, "principalWei": { "$ref": "#/$defs/canonicalUintString" } }
              }
            },
            "sponsorshipFundings": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["transactionHash", "payer", "sponsor", "amountWei"],
                "properties": {
                  "transactionHash": { "$ref": "#/$defs/bytes32" }, "payer": { "$ref": "#/$defs/address" },
                  "sponsor": { "$ref": "#/$defs/address" }, "amountWei": { "$ref": "#/$defs/canonicalUintString" }
                }
              }
            },
            "winningsDonations": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["transactionHash", "solver", "destinationPool", "grossAmountWei", "donatedAmountWei", "feeAmountWei"],
                "properties": {
                  "transactionHash": { "$ref": "#/$defs/bytes32" }, "solver": { "$ref": "#/$defs/address" },
                  "destinationPool": { "$ref": "#/$defs/address" }, "grossAmountWei": { "$ref": "#/$defs/canonicalUintString" },
                  "donatedAmountWei": { "$ref": "#/$defs/canonicalUintString" }, "feeAmountWei": { "$ref": "#/$defs/canonicalUintString" }
                }
              }
            }
          }
        },
        "funding": {
          "type": "object", "additionalProperties": false,
          "required": ["acceptingFunds", "fundingArmed", "authorizationExpiresAt", "ledgerPausedNewActions", "submissionsPausedNewActions", "submissionsPausedAll", "challengesPausedNewActions"],
          "properties": {
            "acceptingFunds": { "type": "boolean" }, "fundingArmed": { "type": "boolean" },
            "authorizationExpiresAt": { "$ref": "#/$defs/canonicalUintString" },
            "ledgerPausedNewActions": { "type": "boolean" }, "submissionsPausedNewActions": { "type": "boolean" },
            "submissionsPausedAll": { "type": "boolean" }, "challengesPausedNewActions": { "type": "boolean" }
          }
        },
        "ledgerClose": {
          "type": "object", "additionalProperties": false,
          "required": ["closed", "closedPoolBalanceWei", "feeReserveWei", "closedAt", "claimDeadline", "totalCreditAtoms", "totalGrossClaimedWei", "totalFeeAccruedWei", "feeSwept", "residualSwept"],
          "properties": {
            "closed": { "type": "boolean" },
            "closedPoolBalanceWei": { "$ref": "#/$defs/canonicalUintString" },
            "feeReserveWei": { "$ref": "#/$defs/canonicalUintString" },
            "closedAt": { "$ref": "#/$defs/canonicalUintString" },
            "claimDeadline": { "$ref": "#/$defs/canonicalUintString" },
            "totalCreditAtoms": { "$ref": "#/$defs/canonicalUintString" },
            "totalGrossClaimedWei": { "$ref": "#/$defs/canonicalUintString" },
            "totalFeeAccruedWei": { "$ref": "#/$defs/canonicalUintString" },
            "feeSwept": { "type": "boolean" },
            "residualSwept": { "type": "boolean" }
          }
        },
        "eventProvenance": {
          "type": "object", "additionalProperties": false,
          "required": ["replayEventsDigest", "total", "logs"],
          "properties": {
            "replayEventsDigest": { "$ref": "#/$defs/bytes32" },
            "total": { "type": "integer", "minimum": 0 },
            "logs": { "type": "array", "items": { "$ref": "#/$defs/provenanceLog" } }
          }
        }
      }
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "deployedCodeHash", "abiHash"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "deployedCodeHash": { "$ref": "#/$defs/bytes32" },
        "abiHash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "boardContractBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "ledger", "submissions", "challenges"],
      "properties": {
        "pool": { "$ref": "#/$defs/contractBinding" },
        "ledger": { "$ref": "#/$defs/contractBinding" },
        "submissions": { "$ref": "#/$defs/contractBinding" },
        "challenges": { "$ref": "#/$defs/contractBinding" }
      }
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentCommit", "deploymentConfigHash", "chainId", "startBlock", "contracts", "boards"],
      "properties": {
        "deploymentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "deploymentConfigHash": { "$ref": "#/$defs/bytes32" },
        "chainId": { "type": "integer", "minimum": 1 },
        "startBlock": { "type": "integer", "minimum": 0 },
        "explorerDossierDigest": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timelock", "registry", "rolloverVault", "submissionManagerFactory", "challengeManagerFactory", "objectiveVerifier", "resolverQuorum"],
          "properties": {
            "timelock": { "$ref": "#/$defs/contractBinding" },
            "registry": { "$ref": "#/$defs/contractBinding" },
            "rolloverVault": { "$ref": "#/$defs/contractBinding" },
            "submissionManagerFactory": { "$ref": "#/$defs/contractBinding" },
            "challengeManagerFactory": { "$ref": "#/$defs/contractBinding" },
            "objectiveVerifier": { "$ref": "#/$defs/contractBinding" },
            "resolverQuorum": { "$ref": "#/$defs/contractBinding" }
          }
        },
        "boards": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/boardContractBindings" }
        }
      }
    },
    "finalityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "confirmations", "logChunkSize", "reorgOverlapBlocks", "maxRetries", "retryBaseDelayMs", "maxScanRestarts"],
      "properties": {
        "mode": { "const": "confirmations" },
        "confirmations": { "type": "integer", "minimum": 1 },
        "logChunkSize": { "type": "integer", "minimum": 2 },
        "reorgOverlapBlocks": { "type": "integer", "minimum": 1 },
        "maxRetries": { "type": "integer", "minimum": 1 },
        "retryBaseDelayMs": { "type": "integer", "minimum": 0 },
        "maxScanRestarts": { "type": "integer", "minimum": 1 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromBlock", "toBlock", "toBlockHash", "toBlockTimestamp"],
      "properties": {
        "fromBlock": { "type": "integer", "minimum": 0 },
        "toBlock": { "type": "integer", "minimum": 0 },
        "toBlockHash": { "$ref": "#/$defs/bytes32" },
        "toBlockTimestamp": { "type": "integer", "minimum": 1 }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "total", "counts", "lifecycleCountsComplete"],
      "properties": {
        "digest": { "$ref": "#/$defs/bytes32" },
        "total": { "type": "integer", "minimum": 0 },
        "counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "lifecycleCountsComplete": { "type": "boolean" }
      }
    },
    "onchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionCount", "openSubmissionCount", "bestScoreAtoms", "poolFirstFundedAt", "poolAcceptingFunds", "fundingArmed", "authorizedFundingDigest", "fundingAuthorizationDigest", "fundingAuthorizationExpiresAt", "ledgerPausedNewActions", "submissionsPausedNewActions", "submissionsPausedAll", "submissionExpiryGraceUntil", "challengePausedNewActions", "registryProblemCount", "registryFrozen"],
      "properties": {
        "submissionCount": { "$ref": "#/$defs/integerString" },
        "openSubmissionCount": { "$ref": "#/$defs/integerString" },
        "bestScoreAtoms": { "$ref": "#/$defs/integerString" },
        "poolFirstFundedAt": { "$ref": "#/$defs/integerString" },
        "poolAcceptingFunds": { "type": "boolean" },
        "fundingArmed": { "type": "boolean" },
        "authorizedFundingDigest": { "$ref": "#/$defs/bytes32" },
        "fundingAuthorizationDigest": { "$ref": "#/$defs/bytes32" },
        "fundingAuthorizationExpiresAt": { "$ref": "#/$defs/integerString" },
        "ledgerPausedNewActions": { "type": "boolean" },
        "submissionsPausedNewActions": { "type": "boolean" },
        "submissionsPausedAll": { "type": "boolean" },
        "submissionExpiryGraceUntil": { "$ref": "#/$defs/integerString" },
        "challengePausedNewActions": { "type": "boolean" },
        "registryProblemCount": { "$ref": "#/$defs/integerString" },
        "registryFrozen": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ok", "expected", "actual"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "expected": {},
        "actual": {}
      }
    },
    "boardReconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "complete", "lifecycleSnapshotComplete", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "lifecycleSnapshotComplete": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "complete", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problemId", "problemSlug", "events", "onchain", "state", "portalProjection", "reconstruction"],
      "properties": {
        "problemId": { "$ref": "#/$defs/positiveUintString" },
        "problemSlug": { "$ref": "#/$defs/problemSlug" },
        "events": { "$ref": "#/$defs/events" },
        "onchain": { "$ref": "#/$defs/onchain" },
        "state": { "type": "object" },
        "portalProjection": { "$ref": "#/$defs/portalProjection" },
        "reconstruction": { "$ref": "#/$defs/boardReconstruction" }
      }
    }
  }
}
