# Canonical, self-contained P42 verifier image.
#
# Builds a runnable, pinnable image for one problem's exact verifier. Unlike the
# per-problem Dockerfiles (which assumed the repo layout), this bundles the
# p42_prizes package AND the problem. The sandbox invokes the explicit
# `problem.yaml` verifier command, so no mutable system package is needed.
# Build from the REPO ROOT:
#
#   docker build -f Dockerfile.verifier --build-arg PROBLEM=hadamard-mini \
#     -t p42-verifier/hadamard-mini .
#
# The runner sandbox (src/p42_prizes/runner_sandbox.py) then executes it with
# `--network=none`, cgroup memory/PID/CPU caps, a read-only rootfs, dropped caps,
# a non-root user, and the untrusted solution mounted read-only.
# Base pinned by digest (audit F23): the tag alone is mutable, so a re-push of
# python:3.14.2-slim could silently change the verifier environment. The digest
# is the MULTI-ARCH OCI index digest (verified via `docker manifest inspect`),
# so this pin builds on any platform. To refresh after a deliberate base bump:
#   docker pull python:<tag> && docker inspect --format='{{index .RepoDigests 0}}' python:<tag>
FROM python:3.14.2-slim@sha256:1a3c6dbfd2173971abba880c3cc2ec4643690901f6ad6742d0827bae6cefc925
ARG PROBLEM
ARG SOURCE_COMMIT
ARG VERIFIER_SOURCE_SHA256
ARG VERIFIER_PROBLEM_ID
ARG VERIFIER_VERSION

# Registry admission binds the pulled image to the exact checkout and verifier
# package it was built from. The local smoke tool supplies all four values and
# verifies them after the build; incomplete labels fail the admission gate.
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      io.projectforty2.verifier.source-sha256="${VERIFIER_SOURCE_SHA256}" \
      io.projectforty2.verifier.problem-id="${VERIFIER_PROBLEM_ID}" \
      io.projectforty2.verifier.version="${VERIFIER_VERSION}"

# Determinism knobs the verifier standard requires.
ENV PYTHONHASHSEED=0 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    PYTHONPATH=/repo/src

# The P42 CLI is part of every verifier invocation. Install its fully
# hash-locked runtime before copying the source tree it imports from.
COPY requirements.runtime.lock /repo/requirements.runtime.lock
RUN pip install --no-cache-dir --require-hashes -r /repo/requirements.runtime.lock

# Preserve the repo-relative layout: the problem Makefile uses PYTHONPATH=../../src,
# so the problem must sit two levels under /repo with src as a sibling.
COPY src /repo/src
COPY schemas /repo/schemas
COPY problems/${PROBLEM} /repo/problems/${PROBLEM}
WORKDIR /repo/problems/${PROBLEM}

# Pinned per-problem deps (mpmath for Mertens, etc.). Non-stdlib locks carry
# every accepted PyPI distribution hash; comments-only locks are a no-op.
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# The runtime always supplies the manifest-pinned verifier.command explicitly.
# Leave no image-local Makefile entrypoint that could diverge from that command.
