[Unit]
Description=P42 OP Stack censorship fallback
After=network-online.target
Wants=network-online.target
OnFailure=p42-censorship-fallback-alert@%n.service
StartLimitIntervalSec=10min
StartLimitBurst=6

[Service]
Type=oneshot
User=p42-fallback
Group=p42-fallback
EnvironmentFile=/etc/p42/censorship-fallback.env
ExecStartPre=/usr/bin/install -d -m 0700 \
  /var/lib/p42-censorship-fallback/state \
  /var/lib/p42-censorship-fallback/coordination
ExecStart=/usr/local/bin/p42-censorship-fallback-supervisor \
  --runtime /usr/local/bin/p42-censorship-fallback \
  --step-timeout-ms 120000 --kill-grace-ms 10000 --retry-delay-ms 15000 \
  --max-rpc-retries 8 -- \
  --plan ${P42_FALLBACK_PLAN} --plan-root ${P42_FALLBACK_PLAN_ROOT} \
  --authorization ${P42_FALLBACK_AUTHORIZATION} --authorization-root ${P42_FALLBACK_AUTHORIZATION_ROOT} \
  --authorization-approver ${P42_FALLBACK_AUTHORIZATION_APPROVER} \
  --state /var/lib/p42-censorship-fallback/state/run.json \
  --state-root /var/lib/p42-censorship-fallback/state \
  --coordination-root /var/lib/p42-censorship-fallback/coordination \
  --l1-chain-id ${P42_L1_CHAIN_ID} \
  --l2-start-block ${P42_L2_START_BLOCK} --l1-gas-limit ${P42_L1_GAS_LIMIT} \
  --max-fee-per-gas ${P42_MAX_FEE_PER_GAS} \
  --max-priority-fee-per-gas ${P42_MAX_PRIORITY_FEE_PER_GAS} \
  --max-rpc-head-lag-blocks ${P42_MAX_RPC_HEAD_LAG_BLOCKS} \
  --max-l2-scan-blocks ${P42_MAX_L2_SCAN_BLOCKS} --max-l2-logs ${P42_MAX_L2_LOGS}
Restart=on-failure
RestartSec=15s
RestartPreventExitStatus=64
TimeoutStopSec=20s
UMask=0077
StateDirectory=p42-censorship-fallback
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/p42-censorship-fallback

[Install]
WantedBy=multi-user.target
