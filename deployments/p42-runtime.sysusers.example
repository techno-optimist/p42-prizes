u p42-indexer - "P42 indexer runtime" /var/lib/p42/indexer /usr/sbin/nologin
u p42-runtime-evidence - "P42 runtime failure evidence recorder" /var/lib/p42/runtime-evidence /usr/sbin/nologin
m p42-operator-2 p42-verifier-submitters
m p42-operator-3 p42-verifier-submitters
m p42-operator-4 p42-verifier-submitters
m p42-operator-5 p42-verifier-submitters
m p42-operator-6 p42-verifier-submitters
m p42-operator-8 p42-verifier-submitters
m p42-operator-9 p42-verifier-submitters
m p42-operator-10 p42-verifier-submitters
m p42-operator-11 p42-verifier-submitters
m p42-operator-12 p42-verifier-submitters
