g p42-verifier-submitters -
u p42-operator-2 - "P42 board 2 operator runtime" /var/lib/p42/operator/2 /usr/sbin/nologin
u p42-operator-3 - "P42 board 3 operator runtime" /var/lib/p42/operator/3 /usr/sbin/nologin
u p42-operator-4 - "P42 board 4 operator runtime" /var/lib/p42/operator/4 /usr/sbin/nologin
u p42-operator-5 - "P42 board 5 operator runtime" /var/lib/p42/operator/5 /usr/sbin/nologin
u p42-operator-6 - "P42 board 6 operator runtime" /var/lib/p42/operator/6 /usr/sbin/nologin
u p42-operator-8 - "P42 board 8 operator runtime" /var/lib/p42/operator/8 /usr/sbin/nologin
u p42-operator-9 - "P42 board 9 operator runtime" /var/lib/p42/operator/9 /usr/sbin/nologin
u p42-operator-10 - "P42 board 10 operator runtime" /var/lib/p42/operator/10 /usr/sbin/nologin
u p42-operator-11 - "P42 board 11 operator runtime" /var/lib/p42/operator/11 /usr/sbin/nologin
u p42-operator-12 - "P42 board 12 operator runtime" /var/lib/p42/operator/12 /usr/sbin/nologin
u p42-verifier-executor - "P42 host verifier executor" /var/lib/p42/verifier-executor /usr/sbin/nologin
