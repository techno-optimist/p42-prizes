{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/problems/q6-intersecting-hypergraph/solution.schema.json",
  "x-p42-max-bytes": 65536,
  "type": "object",
  "required": ["vertices", "edges"],
  "additionalProperties": false,
  "properties": {
    "vertices": {
      "type": "integer",
      "minimum": 6,
      "maximum": 321
    },
    "source": { "type": "string" },
    "claimed_improvement": { "type": "string" },
    "claimed_score": { "type": "string" },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 320
        }
      }
    }
  }
}
