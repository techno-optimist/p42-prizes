{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/problems/b3-ruler-11-marks/solution.schema.json",
  "x-p42-max-bytes": 4096,
  "type": "object",
  "required": ["marks"],
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string" },
    "claimed_score": { "type": "string" },
    "claimed_improvement": { "type": "string" },
