{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/problems/hadamard-mini/solution.schema.json",
  "x-p42-max-bytes": 4096,
  "type": "object",
  "required": ["n", "rows"],
  "additionalProperties": false,
  "properties": {
    "n": { "const": 4 },
    "claimed_defect": { "type": "integer" },
    "claimed_score": { "type": "string" },
    "improvement": { "type": "string" },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[+-]{4}$"
      }
    }
  }
}
