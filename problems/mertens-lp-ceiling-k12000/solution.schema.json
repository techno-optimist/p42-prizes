{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/problems/mertens-lp-ceiling-k12000/solution.schema.json",
  "type": "object",
  "required": ["K", "M", "denom_pow", "printed_decimal", "y_hash_sha256", "m", "Y"],
  "additionalProperties": true,
  "properties": {
    "K": { "const": 12000 },
    "M": { "const": 120000 },
    "denom_pow": { "const": 48 },
    "printed_decimal": {
      "type": "string",
      "pattern": "^0\\.[0-9]{25}$"
    },
    "y_hash_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "m": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 119999
      }
    },
    "Y": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
