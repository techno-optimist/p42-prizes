{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p42.xyz/problems/signed-autoconvolution-c3-upper/solution.schema.json",
  "type": "object",
  "required": ["n", "denominator_power", "values"],
  "additionalProperties": true,
  "properties": {
    "n": { "const": 100000 },
    "denominator_power": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "values": {
      "type": "array",
      "minItems": 100000,
      "maxItems": 100000,
      "items": {
        "type": "integer"
      }
    }
  }
}
